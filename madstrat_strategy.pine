f_get_weekly_days_offset() =>
    int result = 5
    int dow = dayofweek(time, i_rolloverTimezone)
    if i_weeklyLevelEndDay == "Current Day"
        result := switch dow
            dayofweek.sunday   => 1
            dayofweek.monday   => 1
            dayofweek.tuesday  => 2
            dayofweek.wednesday => 3
            dayofweek.thursday => 4
            dayofweek.friday   => 5
            dayofweek.saturday => 5
            => 5
    else if i_weeklyLevelEndDay == "Current Day + 1"
        result := switch dow
            dayofweek.sunday   => 2
            dayofweek.monday   => 2
            dayofweek.tuesday  => 3
            dayofweek.wednesday => 4
            dayofweek.thursday => 5
            dayofweek.friday   => 5
            dayofweek.saturday => 1
            => 5
    else
        result := switch i_weeklyLevelEndDay
            "Monday"    => 1
            "Tuesday"   => 2
            "Wednesday" => 3
            "Thursday"  => 4
            "Friday"    => 5
            => 5
    result
int weeklyLevelDaysOffset = f_get_weekly_days_offset()
f_get_baseline_tolerance() =>
    float result = 0.0
    bool is_gold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")
    bool is_silver = str.contains(str.upper(syminfo.ticker), "XAG") or str.contains(str.upper(syminfo.ticker), "SILVER")
    bool is_metal = is_gold or is_silver or i_instrumentType == "Gold/Metals"
    if is_gold
        result := 150 * syminfo.mintick
    else if is_silver
        result := 50 * syminfo.mintick
    else if is_metal
        result := 100 * syminfo.mintick
    else
        result := 12 * syminfo.mintick * 10
    result
float baseline_tolerance = f_get_baseline_tolerance()
f_get_breakout_points() =>
    float result = 0.0
    if i_instrumentType == "Gold/Metals"
        result := 100 * syminfo.mintick
    else if i_instrumentType == "Forex"
        result := 10 * syminfo.mintick * 10
    else
        if str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") or str.contains(str.upper(syminfo.ticker), "XAG") or str.contains(str.upper(syminfo.ticker), "SILVER")
            result := 100 * syminfo.mintick
        else
            result := 10 * syminfo.mintick * 10
    result
float breakout_points = f_get_breakout_points()
f_get_label_size(string size_str) =>
    switch size_str
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.normal
f_get_table_text_size(string sizeStr) =>
    switch sizeStr
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small
// SECTION 4: INDICATORS & SECURITY CALLS
float ema9 = ta.ema(close, 9)
float ema18 = ta.ema(close, 18)
float ema50 = ta.ema(close, 50)
float sma50 = ta.sma(close, 50)
float trail_atr = ta.atr(i_trailAtrPeriod)
f_get_htf_data() =>
    [open, high, low, close, ta.ema(close, 9), ta.ema(close, 18), ta.ema(close, 50), ta.sma(close, 50)]
f_get_5m_data() =>
    [ta.ema(close, 9), ta.ema(close, 18), ta.ema(close, 50), ta.sma(close, 50)]
[htf_1hr_o, htf_1hr_h, htf_1hr_l, htf_1hr_c, htf_1hr_ema9, htf_1hr_ema18, htf_1hr_ema50, htf_1hr_sma50] = request.security(syminfo.tickerid, "60", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[htf_2hr_o, htf_2hr_h, htf_2hr_l, htf_2hr_c, htf_2hr_ema9, htf_2hr_ema18, htf_2hr_ema50, htf_2hr_sma50] = request.security(syminfo.tickerid, "120", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[htf_4hr_o, htf_4hr_h, htf_4hr_l, htf_4hr_c, htf_4hr_ema9, htf_4hr_ema18, htf_4hr_ema50, htf_4hr_sma50] = request.security(syminfo.tickerid, "240", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[htf_12hr_o, htf_12hr_h, htf_12hr_l, htf_12hr_c, htf_12hr_ema9, htf_12hr_ema18, htf_12hr_ema50, htf_12hr_sma50] = request.security(syminfo.tickerid, "720", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[htf_d_o, htf_d_h, htf_d_l, htf_d_c, htf_d_ema9, htf_d_ema18, htf_d_ema50, htf_d_sma50] = request.security(syminfo.tickerid, "D", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[ltf_15m_o, ltf_15m_h, ltf_15m_l, ltf_15m_c, ltf_15m_ema9, ltf_15m_ema18, ltf_15m_ema50, ltf_15m_sma50] = request.security(syminfo.tickerid, "15", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[ltf_30m_o, ltf_30m_h, ltf_30m_l, ltf_30m_c, ltf_30m_ema9, ltf_30m_ema18, ltf_30m_ema50, ltf_30m_sma50] = request.security(syminfo.tickerid, "30", f_get_htf_data(), lookahead=barmerge.lookahead_off)
[fiveM_ema9, fiveM_ema18, fiveM_ema50, fiveM_sma50] = request.security(syminfo.tickerid, "5", f_get_5m_data(), lookahead=barmerge.lookahead_off)
// --- Signal Timeframe ATR for dynamic SL buffer ---
float ltf_15m_atr14 = request.security(syminfo.tickerid, "15", ta.atr(14), lookahead=barmerge.lookahead_off)
float ltf_30m_atr14 = request.security(syminfo.tickerid, "30", ta.atr(14), lookahead=barmerge.lookahead_off)
// SECTION 5: 5M AUTHORITATIVE DAY ENGINE
f_day_state_5m(string tz, int rolloverHour, int sundayOpenHour, int sundayOpenMinute, int fridayCloseHour, int fridayCloseMinute, bool backtestMode) =>
    int current_dow = dayofweek(time, tz)
    int current_hour = hour(time, tz)
    int current_minute = minute(time, tz)
    int prev_dow = dayofweek(time[1], tz)
    int prev_hour = hour(time[1], tz)
    int prev_minute = minute(time[1], tz)
    int current_minutes = current_hour * 60 + current_minute
    int prev_minutes = prev_hour * 60 + prev_minute
    int sunday_open_minutes = sundayOpenHour * 60 + sundayOpenMinute
    int friday_close_minutes = fridayCloseHour * 60 + fridayCloseMinute
    int standard_rollover_minutes = rolloverHour * 60
    int power_of_3_day = current_dow == dayofweek.monday ? 1 : current_dow == dayofweek.tuesday ? 2 : current_dow == dayofweek.wednesday ? 3 : current_dow == dayofweek.thursday ? 2 : current_dow == dayofweek.friday ? 3 : 0
    bool is_time_gap = (time - time[1]) > 14400000
    bool sunday_gap_condition = is_time_gap and current_dow == dayofweek.sunday and current_minutes >= sunday_open_minutes
    bool sunday_time_condition = current_dow == dayofweek.sunday and current_minutes >= sunday_open_minutes and (prev_dow != dayofweek.sunday or prev_minutes < sunday_open_minutes)
    bool is_sunday_rollover = sunday_gap_condition or sunday_time_condition
    bool is_friday_rollover = current_dow == dayofweek.friday and current_minutes >= friday_close_minutes and prev_minutes < friday_close_minutes
    bool is_midweek_rollover = current_dow >= dayofweek.monday and current_dow <= dayofweek.thursday and current_minutes >= standard_rollover_minutes and prev_minutes < standard_rollover_minutes
    bool is_rollover = is_sunday_rollover or is_friday_rollover or is_midweek_rollover
    var float running_daily_high = na
    var float running_daily_low = na
    var float running_daily_open = na
    var int running_daily_time = na
    var float pdh = na
    var float pdl = na
    var float pdo = na
    var float pdc = na
    var int pdt = na
    var float day_before_h = na
    var float day_before_l = na
    var float day_before_o = na
    var float day_before_c = na
    if na(running_daily_high)
        running_daily_high := high
        running_daily_low := low
        running_daily_open := open
        running_daily_time := time
    if is_rollover
        if dayofweek(time[1], tz) != dayofweek.saturday
            day_before_h := pdh
            day_before_l := pdl
            day_before_o := pdo
            day_before_c := pdc
            pdh := running_daily_high[1]
            pdl := running_daily_low[1]
            pdo := running_daily_open[1]
            pdc := close[1]
            pdt := running_daily_time[1]
        running_daily_high := high
        running_daily_low := low
        running_daily_open := open
        running_daily_time := time
    else
        running_daily_high := math.max(running_daily_high, high)
        running_daily_low := math.min(running_daily_low, low)
    float daily_mid = (not na(pdh) and not na(pdl)) ? (pdh + pdl) / 2.0 : na
    var float prev_week_high = na
    var float prev_week_low = na
    var float prev_week_eq = na
    var float current_week_running_high = na
    var float current_week_running_low = na
    var int current_week_start_time = na
    var int previous_week_start_time = na
    var bool pwh_closed_through = false
    var bool pwl_closed_through = false
    bool is_new_week = is_sunday_rollover
    if is_new_week
        int adjusted_week_start = time - ((current_minutes - sunday_open_minutes) * 60 * 1000)
        prev_week_high := current_week_running_high
        prev_week_low := current_week_running_low
        if not na(current_week_running_high) and not na(current_week_running_low)
            prev_week_eq := (current_week_running_high + current_week_running_low) / 2
        previous_week_start_time := current_week_start_time
        current_week_running_high := high
        current_week_running_low := low
        current_week_start_time := adjusted_week_start
        pwh_closed_through := false
        pwl_closed_through := false
    else
        if not na(current_week_running_high)
            current_week_running_high := math.max(current_week_running_high, high)
            current_week_running_low := math.min(current_week_running_low, low)
        else
            current_week_running_high := high
            current_week_running_low := low
            current_week_start_time := time
    if is_rollover and not is_new_week and not na(prev_week_high) and not na(prev_week_low)
        if pdc > prev_week_high
            pwh_closed_through := true
        if pdc < prev_week_low
            pwl_closed_through := true
    var int gsd_count = 0
    var int rsd_count = 0
    var bool counting_started = false
    var bool week_has_fbr = false
    var bool fbr_origin_cycle = false
    var bool week_has_clean_breakout_high = false
    var bool week_has_clean_breakout_low = false
    var bool inside_day_freeze = false
    var string currentTrend = na
    var string currentPrefix = na
    var bool isSetup = false
    var int consecutive_bull_days = 0
    var int consecutive_bear_days = 0
    var int dayLabelType = DLABEL_NORMAL
    var int prev_day_label_type = DLABEL_NORMAL
    if backtestMode and bar_index == 0
        counting_started := true
        currentTrend := "green"
        currentPrefix := "GD Day "
        gsd_count := 2
    if is_rollover and not na(pdt)
        float finished_day_high = pdh
        float finished_day_low = pdl
        float finished_day_open = pdo
        float finished_day_close = pdc
        int finished_day_time = pdt
        bool is_start_of_week = dayofweek(finished_day_time, tz) == dayofweek.sunday
        if is_start_of_week
            counting_started := true
            week_has_fbr := false
            fbr_origin_cycle := false
            week_has_clean_breakout_high := false
            week_has_clean_breakout_low := false
            consecutive_bull_days := 0
            consecutive_bear_days := 0
            pwl_closed_through := false
            pwh_closed_through := false
        bool is_inside_day = not na(day_before_h) and finished_day_high < day_before_h and finished_day_low > day_before_l
        dayLabelType := DLABEL_NORMAL
        if is_inside_day
            bool prev_was_setup = (prev_day_label_type == DLABEL_FBR_BULL or prev_day_label_type == DLABEL_FBR_BEAR or
                                   prev_day_label_type == DLABEL_SETUP_GREEN or prev_day_label_type == DLABEL_SETUP_RED)
            if i_enableInsideDayCont and not prev_was_setup
                // Inside Day always freezes count — but next day can continue the cycle
                inside_day_freeze := false
                dayLabelType := DLABEL_INSIDE
            else
                inside_day_freeze := true
                dayLabelType := DLABEL_INSIDE
        else
            inside_day_freeze := false
            bool day_was_bullish = finished_day_close > finished_day_open
            bool day_was_bearish = finished_day_close < finished_day_open
            bool can_fbr_bull = counting_started and not week_has_fbr and not week_has_clean_breakout_low and not pwl_closed_through
            bool can_fbr_bear = counting_started and not week_has_fbr and not week_has_clean_breakout_high and not pwh_closed_through
            bool labeled = false
            if counting_started and not na(prev_week_high) and not na(prev_week_low)
                bool clean_bull = not week_has_clean_breakout_high and finished_day_high > prev_week_high and finished_day_close > prev_week_high
                bool clean_bear = not week_has_clean_breakout_low and finished_day_low < prev_week_low and finished_day_close < prev_week_low
                if clean_bull
                    week_has_clean_breakout_high := true
                    consecutive_bull_days := 1
                    consecutive_bear_days := 0
                    dayLabelType := DLABEL_CLEAN_BULL
                    if day_was_bullish
                        if currentTrend == "red"
                            isSetup := rsd_count >= 2
                            currentPrefix := isSetup ? "GSD Day " : "GD Day "
                            gsd_count := 1
                            currentTrend := "green"
                        else
                            gsd_count += 1
                        rsd_count := 0
                    else
                        if currentTrend == "green"
                            isSetup := gsd_count >= 2
                            currentPrefix := isSetup ? "RSD Day " : "RD Day "
                            rsd_count := 1
                            currentTrend := "red"
                        else
                            rsd_count += 1
                        gsd_count := 0
                    labeled := true
                else if clean_bear
                    week_has_clean_breakout_low := true
                    consecutive_bear_days := 1
                    consecutive_bull_days := 0
                    dayLabelType := DLABEL_CLEAN_BEAR
                    if day_was_bullish
                        if currentTrend == "red"
                            isSetup := rsd_count >= 2
                            currentPrefix := isSetup ? "GSD Day " : "GD Day "
                            gsd_count := 1
                            currentTrend := "green"
                        else
                            gsd_count += 1
                        rsd_count := 0
                    else
                        if currentTrend == "green"
                            isSetup := gsd_count >= 2
                            currentPrefix := isSetup ? "RSD Day " : "RD Day "
                            rsd_count := 1
                            currentTrend := "red"
                        else
                            rsd_count += 1
                        gsd_count := 0
                    labeled := true
            if not labeled and not na(prev_week_high) and not na(prev_week_low)
                bool bull_fbr = can_fbr_bull and finished_day_low < prev_week_low and finished_day_close > prev_week_low and finished_day_close < prev_week_high
                bool bear_fbr = can_fbr_bear and finished_day_high > prev_week_high and finished_day_close < prev_week_high and finished_day_close > prev_week_low
                if i_enforceFBRDirection
                    bull_fbr := bull_fbr and day_was_bullish
                    bear_fbr := bear_fbr and day_was_bearish
                if bull_fbr
                    week_has_fbr := true
                    gsd_count := 1
                    rsd_count := 0
                    currentTrend := "green"
                    isSetup := true
                    currentPrefix := "GSD Day "
                    consecutive_bull_days := 1
                    consecutive_bear_days := 0
                    dayLabelType := DLABEL_FBR_BULL
                    fbr_origin_cycle := true
                    labeled := true
                else if bear_fbr
                    week_has_fbr := true
                    rsd_count := 1
                    gsd_count := 0
                    currentTrend := "red"
                    isSetup := true
                    currentPrefix := "RSD Day "
                    consecutive_bear_days := 1
                    consecutive_bull_days := 0
                    dayLabelType := DLABEL_FBR_BEAR
                    fbr_origin_cycle := true
                    labeled := true
            if not labeled and counting_started
                bool is_red_setup_day = consecutive_bull_days >= 2 and day_was_bearish
                bool is_green_setup_day = consecutive_bear_days >= 2 and day_was_bullish
                if is_green_setup_day
                    gsd_count := 1
                    rsd_count := 0
                    currentTrend := "green"
                    isSetup := true
                    currentPrefix := "GSD Day "
                    consecutive_bull_days := 1
                    consecutive_bear_days := 0
                    dayLabelType := DLABEL_SETUP_GREEN
                    fbr_origin_cycle := false
                    labeled := true
                else if is_red_setup_day
                    rsd_count := 1
                    gsd_count := 0
                    currentTrend := "red"
                    isSetup := true
                    currentPrefix := "RSD Day "
                    consecutive_bear_days := 1
                    consecutive_bull_days := 0
                    dayLabelType := DLABEL_SETUP_RED
                    fbr_origin_cycle := false
                    labeled := true
            if not labeled and counting_started
                if day_was_bullish
                    consecutive_bull_days += 1
                    consecutive_bear_days := 0
                else if day_was_bearish
                    consecutive_bear_days += 1
                    consecutive_bull_days := 0
                if day_was_bullish
                    if currentTrend == "red"
                        isSetup := rsd_count >= 2
                        currentPrefix := isSetup ? "GSD Day " : "GD Day "
                        gsd_count := 1
                        currentTrend := "green"
                    else
                        gsd_count += 1
                    rsd_count := 0
                else
                    if currentTrend == "green"
                        isSetup := gsd_count >= 2
                        currentPrefix := isSetup ? "RSD Day " : "RD Day "
                        rsd_count := 1
                        currentTrend := "red"
                    else
                        rsd_count += 1
                    gsd_count := 0
        prev_day_label_type := dayLabelType
    int prefixEnum = currentPrefix == "GSD Day " ? PREFIX_GSD : currentPrefix == "RSD Day " ? PREFIX_RSD : currentPrefix == "GD Day " ? PREFIX_GD : currentPrefix == "RD Day " ? PREFIX_RD : PREFIX_NONE
    [prefixEnum, gsd_count, rsd_count, inside_day_freeze, is_rollover, daily_mid, pdh, pdl, prev_week_high, prev_week_low, prev_week_eq, power_of_3_day, dayLabelType, week_has_fbr, week_has_clean_breakout_high, week_has_clean_breakout_low, fbr_origin_cycle]
[prefix5, gsd5, rsd5, insideFreeze5, rollover5, dailyMid5, pdh5, pdl5, pwh5, pwl5, pweq5, p3day5, dayLabelType5, weekHasFbr5, weekHasCleanBOHigh5, weekHasCleanBOLow5, fbrOriginCycle5] = request.security(syminfo.tickerid, "5", f_day_state_5m(i_rolloverTimezone, i_rolloverHour, i_sundayOpenHour, i_sundayOpenMinute, i_fridayCloseHour, i_fridayCloseMinute, i_backtestMode), lookahead=barmerge.lookahead_off)
// SECTION 6: CHART-LEVEL DAY CLASSIFICATION
int current_dow = dayofweek(time, i_rolloverTimezone)
int current_hour = hour(time, i_rolloverTimezone)
int current_minute = minute(time, i_rolloverTimezone)
int prev_dow = dayofweek(time[1], i_rolloverTimezone)
int prev_hour = hour(time[1], i_rolloverTimezone)
int prev_minute = minute(time[1], i_rolloverTimezone)
int current_minutes = current_hour * 60 + current_minute
int prev_minutes = prev_hour * 60 + prev_minute
int sunday_open_minutes = i_sundayOpenHour * 60 + i_sundayOpenMinute
int friday_close_minutes = i_fridayCloseHour * 60 + i_fridayCloseMinute
int standard_rollover_minutes = i_rolloverHour * 60
f_get_power_of_3_count(_dow) =>
    int result = switch _dow
        dayofweek.monday => 1
        dayofweek.tuesday => 2
        dayofweek.wednesday => 3
        dayofweek.thursday => 2
        dayofweek.friday => 3
        => 0
    result
int power_of_3_day = f_get_power_of_3_count(current_dow)
bool is_time_gap = (time - time[1]) > 14400000
bool sunday_gap_condition = is_time_gap and current_dow == dayofweek.sunday and current_minutes >= sunday_open_minutes
bool sunday_time_condition = current_dow == dayofweek.sunday and current_minutes >= sunday_open_minutes and (prev_dow != dayofweek.sunday or prev_minutes < sunday_open_minutes)
bool is_sunday_rollover = sunday_gap_condition or sunday_time_condition
bool is_friday_rollover = current_dow == dayofweek.friday and current_minutes >= friday_close_minutes and prev_minutes < friday_close_minutes
bool is_midweek_rollover = current_dow >= dayofweek.monday and current_dow <= dayofweek.thursday and current_minutes >= standard_rollover_minutes and prev_minutes < standard_rollover_minutes
bool is_rollover = is_sunday_rollover or is_friday_rollover or is_midweek_rollover
bool is_monday_trading_day = dayofweek(time, i_rolloverTimezone) == dayofweek.monday or
     (dayofweek(time, i_rolloverTimezone) == dayofweek.sunday and current_minutes >= sunday_open_minutes)
var float running_daily_high = high
var float running_daily_low = low
var float running_daily_open = open
var int running_daily_time = time
var float pdh = na
var float pdl = na
var float pdo = na
var float pdc = na
var int pdt = na
var float day_before_h = na
var float day_before_l = na
var float day_before_o = na
var float day_before_c = na
if is_rollover
    if dayofweek(time[1], i_rolloverTimezone) != dayofweek.saturday
        day_before_h := pdh
        day_before_l := pdl
        day_before_o := pdo
        day_before_c := pdc
        pdh := running_daily_high[1]
        pdl := running_daily_low[1]
        pdo := running_daily_open[1]
        pdc := close[1]
        pdt := running_daily_time[1]
    running_daily_high := high
    running_daily_low := low
    running_daily_open := open
    running_daily_time := time
else
    if not na(running_daily_high)
        running_daily_high := math.max(running_daily_high, high)
        running_daily_low := math.min(running_daily_low, low)
var float prev_week_high = na
var float prev_week_low = na
var float prev_week_eq = na
var float current_week_running_high = na
var float current_week_running_low = na
var int current_week_start_time = na
var int previous_week_start_time = na
var bool pwh_closed_through = false
var bool pwl_closed_through = false
bool is_new_week = is_sunday_rollover
if is_new_week
    int new_week_start = time - ((current_minutes - sunday_open_minutes) * 60 * 1000)
    prev_week_high := current_week_running_high
    prev_week_low := current_week_running_low
    if not na(current_week_running_high) and not na(current_week_running_low)
        prev_week_eq := (current_week_running_high + current_week_running_low) / 2
    previous_week_start_time := current_week_start_time
    current_week_running_high := high
    current_week_running_low := low
    current_week_start_time := new_week_start
    pwh_closed_through := false
    pwl_closed_through := false
else
    if not na(current_week_running_high)
        current_week_running_high := math.max(current_week_running_high, high)
        current_week_running_low := math.min(current_week_running_low, low)
    else
        current_week_running_high := high
        current_week_running_low := low
        current_week_start_time := time - ((current_minutes - sunday_open_minutes) * 60 * 1000)
bool finished_is_sunday = not na(pdt) and dayofweek(pdt, i_rolloverTimezone) == dayofweek.sunday
if is_rollover and not na(prev_week_high) and not na(prev_week_low) and not finished_is_sunday
    if pdc > prev_week_high
        pwh_closed_through := true
    if pdc < prev_week_low
        pwl_closed_through := true
float curr_week_high = current_week_running_high
float curr_week_low = current_week_running_low
float curr_week_eq = not na(curr_week_high) and not na(curr_week_low) ? (curr_week_high + curr_week_low) / 2 : na
float daily_mid = not na(pdh) and not na(pdl) ? (pdh + pdl) / 2 : na
var int gsd_count = 0
var int rsd_count = 0
var bool counting_started = false
var bool week_has_fbr = false
var bool fbr_origin_cycle = false
var bool week_has_clean_breakout_high = false
var bool week_has_clean_breakout_low = false
var bool global_is_inside_day = false
var string currentTrend = na
var string currentPrefix = na
var bool isSetup = false
var int consecutive_bull_days = 0
var int consecutive_bear_days = 0
var bool inside_day_freeze = false
var array<label> managed_labels = array.new_label(0)
var array<line> session_break_lines = array.new_line(0)
var array<line> historical_daily_lines = array.new_line(0)
var label realtime_day_label = na
if i_backtestMode and bar_index == 0
    counting_started := true
    currentTrend := "green"
    currentPrefix := "GD Day "
    gsd_count := 2
if is_rollover and not na(pdt)
    currentTrend := (prefix5 == PREFIX_GSD or prefix5 == PREFIX_GD) ? "green" : (prefix5 == PREFIX_RSD or prefix5 == PREFIX_RD) ? "red" : currentTrend
    currentPrefix := prefix5 == PREFIX_GSD ? "GSD Day " : prefix5 == PREFIX_RSD ? "RSD Day " : prefix5 == PREFIX_GD ? "GD Day " : prefix5 == PREFIX_RD ? "RD Day " : currentPrefix
    gsd_count := gsd5
    rsd_count := rsd5
    inside_day_freeze := insideFreeze5
    isSetup := (prefix5 == PREFIX_GSD or prefix5 == PREFIX_RSD)
    week_has_fbr := weekHasFbr5
    fbr_origin_cycle := fbrOriginCycle5
    week_has_clean_breakout_high := weekHasCleanBOHigh5
    week_has_clean_breakout_low := weekHasCleanBOLow5
    counting_started := (prefix5 != PREFIX_NONE) ? true : counting_started
    bool is_start_of_week_chart = dayofweek(pdt, i_rolloverTimezone) == dayofweek.sunday
    if is_start_of_week_chart
        pwl_closed_through := false
        pwh_closed_through := false
    float finished_day_high = pdh
    float finished_day_low = pdl
    int finished_day_time = pdt
    string tooltip = str.format("{0,date,dd-MMM}", finished_day_time) + " H:" + str.tostring(pdh, "#.##") + " L:" + str.tostring(pdl, "#.##")
    float daily_range = finished_day_high - finished_day_low
    float label_y = finished_day_high + daily_range * 0.15
    int day_count = gsd5 > 0 ? gsd5 : rsd5
    string prefix_text = currentPrefix + str.tostring(day_count)
    string label_text = ""
    color label_bg = color.gray
    color label_fg = color.white
    switch dayLabelType5
        DLABEL_INSIDE =>
            label_text := "INSIDE DAY"
            label_bg := i_insideLabelColor
            label_fg := i_insideLabelTextColor
            tooltip += "\nType: Inside Day (Count Frozen — Scenario B)"
            global_is_inside_day := true
        DLABEL_INSIDE_CONT =>
            label_text := prefix_text + "\nINSIDE (CONT)"
            label_bg := i_insideLabelColor
            label_fg := i_insideLabelTextColor
            tooltip += "\nType: Inside Day (Continuation — Scenario A, count incremented)"
