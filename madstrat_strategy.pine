bool sell_aligned_now_30m = eff_30m_ema18 > eff_30m_ema9
bool buy_aligned_recently_15m = nz(ta.barssince(eff_15m_ema18[1] < eff_15m_ema9[1]), alignment_lookback + 1) < alignment_lookback
bool sell_aligned_recently_15m = nz(ta.barssince(eff_15m_ema18[1] > eff_15m_ema9[1]), alignment_lookback + 1) < alignment_lookback
bool buy_aligned_recently_30m = nz(ta.barssince(eff_30m_ema18[1] < eff_30m_ema9[1]), alignment_lookback + 1) < alignment_lookback
bool sell_aligned_recently_30m = nz(ta.barssince(eff_30m_ema18[1] > eff_30m_ema9[1]), alignment_lookback + 1) < alignment_lookback
f_ema_alignment_buy(_ema9, _ema18, _ema50) =>
    _ema18 < _ema9
f_ema_alignment_sell(_ema9, _ema18, _ema50) =>
    _ema18 > _ema9
f_candle_closed_above_emas(_close, _ema9, _ema18) =>
    _close > _ema9 and _close > _ema18
f_candle_closed_below_emas(_close, _ema9, _ema18) =>
    _close < _ema9 and _close < _ema18
f_ema_slope_bullish(_ema9, _ema18, _ema50, _lookback) =>
    bool slope_9 = _ema9 > nz(_ema9[_lookback])
    bool slope_18 = _ema18 > nz(_ema18[_lookback])
    bool slope_50 = _ema50 > nz(_ema50[_lookback])
    slope_9 and slope_18 and slope_50
f_ema_slope_bearish(_ema9, _ema18, _ema50, _lookback) =>
    bool slope_9 = _ema9 < nz(_ema9[_lookback])
    bool slope_18 = _ema18 < nz(_ema18[_lookback])
    bool slope_50 = _ema50 < nz(_ema50[_lookback])
    slope_9 and slope_18 and slope_50
f_grade_setup(_15m_aligned, _30m_aligned, _h1_aligned, _h2_aligned, _h4_aligned, _baseline_candle_correct_direction) =>
    int aligned_count = 0
    int total_tfs = 0
    if _15m_aligned != true
        total_tfs += 1
        aligned_count += _15m_aligned ? 1 : 0
    if _30m_aligned != true
        total_tfs += 1
        aligned_count += _30m_aligned ? 1 : 0
    if _h1_aligned != true
        total_tfs += 1
        aligned_count += _h1_aligned ? 1 : 0
    if _h2_aligned != true
        total_tfs += 1
        aligned_count += _h2_aligned ? 1 : 0
    if _h4_aligned != true
        total_tfs += 1
        aligned_count += _h4_aligned ? 1 : 0
    bool all_tfs_aligned = aligned_count == total_tfs
    bool one_or_two_against = aligned_count >= (total_tfs - 2) and aligned_count < total_tfs
    bool is_a_setup = all_tfs_aligned and _baseline_candle_correct_direction
    bool is_b_setup = (one_or_two_against and _baseline_candle_correct_direction) or (all_tfs_aligned and not _baseline_candle_correct_direction)
    [is_a_setup, is_b_setup, aligned_count]
