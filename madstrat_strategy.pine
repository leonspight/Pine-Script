var int bars_since_htf_eq_2hr = 999
bool htf_2hr_baseline_touch = not na(htf_2hr_ema50) and (htf_2hr_l <= htf_2hr_ema50 + htf_baseline_tolerance and htf_2hr_h >= htf_2hr_ema50 - htf_baseline_tolerance)
bool htf_2hr_eq_touch = not na(htf_eq_level) and (htf_2hr_l <= htf_eq_level + tolerance_points and htf_2hr_h >= htf_eq_level - tolerance_points)
bool new_2hr_bar = ta.change(time("120")) != 0
if new_2hr_bar
    if htf_2hr_baseline_touch
        bars_since_htf_baseline_2hr := 0
    else if bars_since_htf_baseline_2hr < 999
        bars_since_htf_baseline_2hr += 1
    if htf_2hr_eq_touch
        bars_since_htf_eq_2hr := 0
    else if bars_since_htf_eq_2hr < 999
        bars_since_htf_eq_2hr += 1
if rollover5
    bars_since_htf_baseline_2hr := 999
    bars_since_htf_eq_2hr := 999
bool htf_baseline_valid_30m = bars_since_htf_baseline_2hr <= i_htfBaselineLookback2hr
bool htf_eq_valid_30m = bars_since_htf_eq_2hr <= i_htfEQLookback2hr
bool htf_confirmed_30m = (not i_requireHTFConfirmation) or (htf_baseline_valid_30m and htf_eq_valid_30m)
f_htf_rejection_bearish(_high, _low, _close, _ema50, _tolerance) =>
    bool touched = _low <= _ema50 + _tolerance and _high >= _ema50 - _tolerance
    bool closed_below = _close < _ema50
    touched and closed_below
f_htf_rejection_bullish(_high, _low, _close, _ema50, _tolerance) =>
    bool touched = _low <= _ema50 + _tolerance and _high >= _ema50 - _tolerance
    bool closed_above = _close > _ema50
    touched and closed_above
bool _htf_1hr_rej_bear_now = f_htf_rejection_bearish(htf_1hr_h, htf_1hr_l, htf_1hr_c, htf_1hr_ema50, htf_baseline_tolerance)
bool _htf_1hr_rej_bull_now = f_htf_rejection_bullish(htf_1hr_h, htf_1hr_l, htf_1hr_c, htf_1hr_ema50, htf_baseline_tolerance)
bool htf_1hr_rejection_bearish = nz(ta.barssince(_htf_1hr_rej_bear_now), i_htfRejectionLookback1hr + 1) < i_htfRejectionLookback1hr
bool htf_1hr_rejection_bullish = nz(ta.barssince(_htf_1hr_rej_bull_now), i_htfRejectionLookback1hr + 1) < i_htfRejectionLookback1hr
bool _htf_2hr_rej_bear_now = f_htf_rejection_bearish(htf_2hr_h, htf_2hr_l, htf_2hr_c, htf_2hr_ema50, htf_baseline_tolerance)
bool _htf_2hr_rej_bull_now = f_htf_rejection_bullish(htf_2hr_h, htf_2hr_l, htf_2hr_c, htf_2hr_ema50, htf_baseline_tolerance)
bool htf_2hr_rejection_bearish = nz(ta.barssince(_htf_2hr_rej_bear_now), i_htfRejectionLookback2hr + 1) < i_htfRejectionLookback2hr
bool htf_2hr_rejection_bullish = nz(ta.barssince(_htf_2hr_rej_bull_now), i_htfRejectionLookback2hr + 1) < i_htfRejectionLookback2hr
bool htf_rejection_blocks_buy_15m = i_blockOnHTFRejection and htf_1hr_rejection_bearish
bool htf_rejection_blocks_sell_15m = i_blockOnHTFRejection and htf_1hr_rejection_bullish
bool htf_rejection_blocks_buy_30m = i_blockOnHTFRejection and htf_2hr_rejection_bearish
bool htf_rejection_blocks_sell_30m = i_blockOnHTFRejection and htf_2hr_rejection_bullish
int gw_hour = hour(time, tz_effective)
bool in_golden_window = (gw_hour >= 1 and gw_hour < 3) or (gw_hour >= 7 and gw_hour < 9)
bool slope_bullish_15m = f_ema_slope_bullish(eff_15m_ema9, eff_15m_ema18, eff_15m_ema50, 3)
bool slope_bearish_15m = f_ema_slope_bearish(eff_15m_ema9, eff_15m_ema18, eff_15m_ema50, 3)
bool slope_bullish_30m = f_ema_slope_bullish(eff_30m_ema9, eff_30m_ema18, eff_30m_ema50, 3)
bool slope_bearish_30m = f_ema_slope_bearish(eff_30m_ema9, eff_30m_ema18, eff_30m_ema50, 3)
bool candle_above_emas_15m = f_candle_closed_above_emas(eff_15m_c, eff_15m_ema9, eff_15m_ema18)
bool candle_below_emas_15m = f_candle_closed_below_emas(eff_15m_c, eff_15m_ema9, eff_15m_ema18)
bool candle_above_emas_30m = f_candle_closed_above_emas(eff_30m_c, eff_30m_ema9, eff_30m_ema18)
bool candle_below_emas_30m = f_candle_closed_below_emas(eff_30m_c, eff_30m_ema9, eff_30m_ema18)
int DAY3_MAX_SCORE = 12
int PURE_MAX_SCORE = 11
f_get_required_confluence(_day_count) =>
    float pct = _day_count <= 1 ? 0.60 : _day_count == 2 ? 0.55 : 0.50
    math.max(math.round(DAY3_MAX_SCORE * pct), 6)
int effective_day_count_gsd = gsd5 > 0 ? gsd5 : 99
int effective_day_count_rsd = rsd5 > 0 ? rsd5 : 99
int conservative_day_buy = math.min(effective_day_count_gsd, p3day5)
int conservative_day_sell = math.min(effective_day_count_rsd, p3day5)
int base_confluence_buy = i_useDynamicConfluence ? f_get_required_confluence(conservative_day_buy) : i_day3MinConfluence
int base_confluence_sell = i_useDynamicConfluence ? f_get_required_confluence(conservative_day_sell) : i_day3MinConfluence
int required_confluence_buy = i_relaxedConditions ? math.max(base_confluence_buy - 2, 3) : base_confluence_buy
int required_confluence_sell = i_relaxedConditions ? math.max(base_confluence_sell - 2, 3) : base_confluence_sell
int pure_base = i_relaxedConditions ? math.max(i_pureMinConfluence - 2, 3) : i_pureMinConfluence
int pure_confluence_required = math.max(pure_base, math.round(PURE_MAX_SCORE * 0.50))
// ─── CONFLUENCE BOOST (v10) ──────────────────────────────────────────
// Raises all thresholds uniformly, capped at max possible score
if i_confluenceBoost > 0
    required_confluence_buy  := math.min(required_confluence_buy + i_confluenceBoost, DAY3_MAX_SCORE)
    required_confluence_sell := math.min(required_confluence_sell + i_confluenceBoost, DAY3_MAX_SCORE)
    pure_confluence_required := math.min(pure_confluence_required + i_confluenceBoost, PURE_MAX_SCORE)
f_confluence_score_day3(_baseline, _alignment, _100pt, _5m, _eq, _golden, _is_day23, _slope, _candle_emas, _rr) =>
    int score = 0
    if _baseline
        score += 2
    if _alignment
        score += 1
    if _100pt
        score += 1
    if _5m
        score += 1
    if _eq
        score += 2
    if _golden
        score += 1
    if _is_day23
        score += 1
    if _slope
        score += 1
    if _candle_emas
        score += 1
    if _rr
        score += 1
    score
f_confluence_score_pure(_baseline, _alignment, _100pt, _5m, _eq, _golden, _slope, _candle_emas, _rr) =>
    int score = 0
    if _baseline
        score += 2
    if _alignment
        score += 1
    if _100pt
        score += 1
    if _5m
        score += 1
    if _eq
        score += 2
    if _golden
        score += 1
    if _slope
        score += 1
    if _candle_emas
        score += 1
    if _rr
        score += 1
    score
// SECTION 8: SIGNAL GENERATION
f_session_string(_start_h, _start_m, _end_h, _end_m) =>
    str.format("{0,number,00}{1,number,00}-{2,number,00}{3,number,00}", _start_h, _start_m, _end_h, _end_m)
bool in_sydney = not na(time(timeframe.period, f_session_string(i_sydneyStartHour, i_sydneyStartMin, i_sydneyEndHour, i_sydneyEndMin), i_rolloverTimezone))
bool in_asian = not na(time(timeframe.period, f_session_string(i_asianStartHour, i_asianStartMin, i_asianEndHour, i_asianEndMin), i_rolloverTimezone))
bool in_london = not na(time(timeframe.period, f_session_string(i_londonStartHour, i_londonStartMin, i_londonEndHour, i_londonEndMin), i_rolloverTimezone))
bool in_ny = not na(time(timeframe.period, f_session_string(i_nyStartHour, i_nyStartMin, i_nyEndHour, i_nyEndMin), i_rolloverTimezone))
bool in_london_ny_overlap = in_london and in_ny
bool in_asian_london_overlap = in_asian and in_london
bool in_session_overlap = i_enableOverlapConfluence and (in_london_ny_overlap or in_asian_london_overlap)
// --- Killzone entry window: restrict entries to specific ET hours (e.g. London/NY overlap) ---
bool in_killzone_window = not i_enableKillzoneEntry or (current_hour >= i_killzoneStartHour and current_hour < i_killzoneEndHour)
bool session_filter_ok = in_killzone_window and (not i_enableSessionFilter or ((i_allowSydney and in_sydney) or (i_allowAsian and in_asian) or (i_allowLondon and in_london) or (i_allowNY and in_ny)))
var int session_signal_count = 0
if (in_asian and not in_asian[1]) or (in_london and not in_london[1]) or (in_ny and not in_ny[1])
    session_signal_count := 0
bool session_limit_ok = session_signal_count < i_maxSignalsPerSession
bool inside_day_realtime = (running_daily_high < pdh and running_daily_low > pdl)
bool inside_day_blocks = inside_day_realtime or inside_day_freeze
// Issue 16: Daily candle direction filter (Webinar 13 non-negotiable)
bool prev_daily_bullish = not i_enforceDailyDirection or (d_close_prev > d_open_prev)
bool prev_daily_bearish = not i_enforceDailyDirection or (d_close_prev < d_open_prev)
// ─── DIRECTION LOCK (v10) ────────────────────────────────────────────
// Manual per-pair directional bias set by trader from HTF analysis
bool lock_allows_long  = i_directionLock != "Short Only"
bool lock_allows_short = i_directionLock != "Long Only"
// ─── HTF TREND FILTER (v10) — Optional, Off by default ──────────────
// Dynamic filter using existing security calls (no additional requests)
bool d1_price_above_50  = htf_d_c > htf_d_ema50
bool d1_price_below_50  = htf_d_c < htf_d_ema50
bool d1_stack_bull      = htf_d_ema9 > htf_d_ema18 and htf_d_ema18 > htf_d_ema50
bool d1_stack_bear      = htf_d_ema9 < htf_d_ema18 and htf_d_ema18 < htf_d_ema50
bool h4_bull            = htf_4hr_ema9 > htf_4hr_ema50
bool h4_bear            = htf_4hr_ema9 < htf_4hr_ema50
bool htf_trend_bullish = switch i_htfTrendMode
    "Off"             => true
    "Daily 50 EMA"    => d1_price_above_50
    "Daily EMA Stack" => d1_stack_bull
    "H4 EMA"          => h4_bull
    "Daily + H4"      => d1_price_above_50 and h4_bull
    => true
bool htf_trend_bearish = switch i_htfTrendMode
    "Off"             => true
    "Daily 50 EMA"    => d1_price_below_50
    "Daily EMA Stack" => d1_stack_bear
    "H4 EMA"          => h4_bear
    "Daily + H4"      => d1_price_below_50 and h4_bear
    => true
// Combined directional gate: candle colour + direction lock + HTF trend
bool dir_filter_buy  = prev_daily_bullish and lock_allows_long and htf_trend_bullish
bool dir_filter_sell = prev_daily_bearish and lock_allows_short and htf_trend_bearish
f_core_conditions(_baseline, _stack, _5m_confirm, _setup_valid, _rr_valid, _eq_rejected, _htf_confirmed, _htf_rejection, _all_levels_touched) =>
    _baseline and _stack and _5m_confirm and _setup_valid and _rr_valid and session_filter_ok and session_limit_ok and (not i_requireEQRejection or _eq_rejected) and _htf_confirmed and not _htf_rejection and (not i_requireAllLevelsTouched or _all_levels_touched)
var float active_h4_top = na
var float active_h4_bot = na
var bool active_h4_is_bull = false
var int active_h4_start = na
var float active_h1_top = na
var float active_h1_bot = na
var bool active_h1_is_bull = false
var int active_h1_start = na
var float active_30m_top = na
var float active_30m_bot = na
var bool active_30m_is_bull = false
var int active_30m_start = na
var float active_15m_top = na
var float active_15m_bot = na
var bool active_15m_is_bull = false
var int active_15m_start = na
f_nearest_exhaustion_long(_entry) =>
    float nearest = na
    float min_dist = 999999.0
    if not na(active_15m_top) and active_15m_top > _entry + tolerance_points
        float dist = active_15m_top - _entry
        if dist < min_dist
            min_dist := dist
            nearest := active_15m_top
    if not na(active_30m_top) and active_30m_top > _entry + tolerance_points
        float dist = active_30m_top - _entry
        if dist < min_dist
            min_dist := dist
            nearest := active_30m_top
    if not na(active_h1_top) and active_h1_top > _entry + tolerance_points
        float dist = active_h1_top - _entry
        if dist < min_dist
            min_dist := dist
            nearest := active_h1_top
    if not na(active_h4_top) and active_h4_top > _entry + tolerance_points
        float dist = active_h4_top - _entry
        if dist < min_dist
            min_dist := dist
            nearest := active_h4_top
    if not na(asia_session_high) and asia_session_high > _entry + tolerance_points
        float dist = asia_session_high - _entry
        if dist < min_dist
            min_dist := dist
            nearest := asia_session_high
    if not na(london_session_high) and london_session_high > _entry + tolerance_points
        float dist = london_session_high - _entry
        if dist < min_dist
            min_dist := dist
            nearest := london_session_high
    if not na(ny_session_high) and ny_session_high > _entry + tolerance_points
        float dist = ny_session_high - _entry
        if dist < min_dist
            min_dist := dist
            nearest := ny_session_high
    if na(nearest) and not na(pdh) and pdh > _entry
        nearest := pdh
    nearest
f_nearest_exhaustion_short(_entry) =>
    float nearest = na
    float min_dist = 999999.0
    if not na(active_15m_bot) and active_15m_bot < _entry - tolerance_points
        float dist = _entry - active_15m_bot
        if dist < min_dist
            min_dist := dist
            nearest := active_15m_bot
    if not na(active_30m_bot) and active_30m_bot < _entry - tolerance_points
        float dist = _entry - active_30m_bot
        if dist < min_dist
            min_dist := dist
            nearest := active_30m_bot
    if not na(active_h1_bot) and active_h1_bot < _entry - tolerance_points
        float dist = _entry - active_h1_bot
        if dist < min_dist
            min_dist := dist
            nearest := active_h1_bot
    if not na(active_h4_bot) and active_h4_bot < _entry - tolerance_points
        float dist = _entry - active_h4_bot
        if dist < min_dist
            min_dist := dist
            nearest := active_h4_bot
    if not na(asia_session_low) and asia_session_low < _entry - tolerance_points
        float dist = _entry - asia_session_low
        if dist < min_dist
            min_dist := dist
            nearest := asia_session_low
    if not na(london_session_low) and london_session_low < _entry - tolerance_points
        float dist = _entry - london_session_low
        if dist < min_dist
            min_dist := dist
            nearest := london_session_low
    if not na(ny_session_low) and ny_session_low < _entry - tolerance_points
        float dist = _entry - ny_session_low
        if dist < min_dist
            min_dist := dist
            nearest := ny_session_low
    if na(nearest) and not na(pdl) and pdl < _entry
        nearest := pdl
    nearest
f_calculate_rr(_entry, _stop, _target) =>
    float risk = math.abs(_entry - _stop)
    float reward = math.abs(_target - _entry)
    risk > 0 ? reward / risk : 0
float rr_target_buy = f_nearest_exhaustion_long(close)
float rr_target_sell = f_nearest_exhaustion_short(close)
float estimated_target_buy = not na(rr_target_buy) ? rr_target_buy : not na(pdh) ? pdh : not na(prev_week_high) ? prev_week_high : close + (close - low) * 3
float estimated_target_sell = not na(rr_target_sell) ? rr_target_sell : not na(pdl) ? pdl : not na(prev_week_low) ? prev_week_low : close - (high - close) * 3
float potential_rr_buy_15m = f_calculate_rr(ltf_15m_c, ltf_15m_l, estimated_target_buy)
float potential_rr_sell_15m = f_calculate_rr(ltf_15m_c, ltf_15m_h, estimated_target_sell)
float potential_rr_buy_30m = f_calculate_rr(ltf_30m_c, ltf_30m_l, estimated_target_buy)
float potential_rr_sell_30m = f_calculate_rr(ltf_30m_c, ltf_30m_h, estimated_target_sell)
bool rr_valid_buy_15m = potential_rr_buy_15m >= i_minRR
bool rr_valid_sell_15m = potential_rr_sell_15m >= i_minRR
bool rr_valid_buy_30m = potential_rr_buy_30m >= i_minRR
bool rr_valid_sell_30m = potential_rr_sell_30m >= i_minRR
bool buy_alignment_dpls  = f_ema_alignment_buy(htf_1hr_ema9, htf_1hr_ema18, htf_1hr_ema50) and
                           f_ema_alignment_buy(htf_2hr_ema9, htf_2hr_ema18, htf_2hr_ema50) and
                           f_ema_alignment_buy(htf_4hr_ema9, htf_4hr_ema18, htf_4hr_ema50)
bool sell_alignment_dpls = f_ema_alignment_sell(htf_1hr_ema9, htf_1hr_ema18, htf_1hr_ema50) and
                           f_ema_alignment_sell(htf_2hr_ema9, htf_2hr_ema18, htf_2hr_ema50) and
                           f_ema_alignment_sell(htf_4hr_ema9, htf_4hr_ema18, htf_4hr_ema50)
bool is_day2_gsd_5m = (prefix5 == PREFIX_GSD) and (gsd5 == 1)
bool is_day3_gsd_5m = (prefix5 == PREFIX_GSD) and (gsd5 == 2)
bool is_day2_rsd_5m = (prefix5 == PREFIX_RSD) and (rsd5 == 1)
bool is_day3_rsd_5m = (prefix5 == PREFIX_RSD) and (rsd5 == 2)
bool is_day23_gsd_5m = is_day2_gsd_5m or is_day3_gsd_5m
bool is_day23_rsd_5m = is_day2_rsd_5m or is_day3_rsd_5m
bool is_gsd_day2_or_3 = is_day23_gsd_5m
bool is_rsd_day2_or_3 = is_day23_rsd_5m
int trading_day_gsd = gsd5 + 1
int trading_day_rsd = rsd5 + 1
int confluence_day3_buy_15m = f_confluence_score_day3(baseline_buy_15m, buy_alignment_15m, buy_100pt_break_15m, buy_5m_confirm, eq_rejected_bull_15m, in_golden_window, is_gsd_day2_or_3, slope_bullish_15m, candle_above_emas_15m, rr_valid_buy_15m)
int confluence_day3_sell_15m = f_confluence_score_day3(baseline_sell_15m, sell_alignment_15m, sell_100pt_break_15m, sell_5m_confirm, eq_rejected_bear_15m, in_golden_window, is_rsd_day2_or_3, slope_bearish_15m, candle_below_emas_15m, rr_valid_sell_15m)
int confluence_pure_buy_15m = f_confluence_score_pure(baseline_buy_15m, buy_alignment_15m, buy_100pt_break_15m, buy_5m_confirm, eq_rejected_bull_15m, in_golden_window, slope_bullish_15m, candle_above_emas_15m, rr_valid_buy_15m)
int confluence_pure_sell_15m = f_confluence_score_pure(baseline_sell_15m, sell_alignment_15m, sell_100pt_break_15m, sell_5m_confirm, eq_rejected_bear_15m, in_golden_window, slope_bearish_15m, candle_below_emas_15m, rr_valid_sell_15m)
if in_session_overlap
    confluence_day3_buy_15m += 1
    confluence_day3_sell_15m += 1
    confluence_pure_buy_15m += 1
    confluence_pure_sell_15m += 1
var bool day2_buy_15m_fired = false
var bool day2_sell_15m_fired = false
var bool day3_buy_15m_fired = false
var bool day3_sell_15m_fired = false
if new_15m_bar or rollover5
    day2_buy_15m_fired := false
    day2_sell_15m_fired := false
    day3_buy_15m_fired := false
    day3_sell_15m_fired := false
bool core_buy_15m = f_core_conditions(baseline_buy_15m, stack_buy_15m, buy_5m_confirm, buy_setup_valid_15m, rr_valid_buy_15m, eq_rejected_bull_15m, htf_confirmed_15m, htf_rejection_blocks_buy_15m, all_levels_touched_buy_15m)
bool core_sell_15m = f_core_conditions(baseline_sell_15m, stack_sell_15m, sell_5m_confirm, sell_setup_valid_15m, rr_valid_sell_15m, eq_rejected_bear_15m, htf_confirmed_15m, htf_rejection_blocks_sell_15m, all_levels_touched_sell_15m)
bool base_buy_15m_conditions = i_showDay3 and not inside_day_blocks and core_buy_15m and dir_filter_buy
bool base_sell_15m_conditions = i_showDay3 and not inside_day_blocks and core_sell_15m and dir_filter_sell
bool day2_buy_15m = base_buy_15m_conditions and is_day2_gsd_5m and not day2_buy_15m_fired and confluence_day3_buy_15m >= required_confluence_buy
bool day2_sell_15m = base_sell_15m_conditions and is_day2_rsd_5m and not day2_sell_15m_fired and confluence_day3_sell_15m >= required_confluence_sell
bool day3_buy_15m = base_buy_15m_conditions and is_day3_gsd_5m and not day3_buy_15m_fired and confluence_day3_buy_15m >= required_confluence_buy
bool day3_sell_15m = base_sell_15m_conditions and is_day3_rsd_5m and not day3_sell_15m_fired and confluence_day3_sell_15m >= required_confluence_sell
if day2_buy_15m
    day2_buy_15m_fired := true
if day2_sell_15m
    day2_sell_15m_fired := true
if day3_buy_15m
    day3_buy_15m_fired := true
if day3_sell_15m
    day3_sell_15m_fired := true
bool day23_buy_15m = day2_buy_15m or day3_buy_15m
bool day23_sell_15m = day2_sell_15m or day3_sell_15m
bool day4_buy_gate = not i_enforceDay4Rule or gsd5 < 3 or (running_daily_high > pdh)
bool day4_sell_gate = not i_enforceDay4Rule or rsd5 < 3 or (running_daily_low < pdl)
bool pure_buy_15m = i_showPureMad and core_buy_15m and day4_buy_gate and confluence_pure_buy_15m >= pure_confluence_required and dir_filter_buy and not inside_day_blocks and not is_day2_gsd_5m and not is_day3_gsd_5m
bool pure_sell_15m = i_showPureMad and core_sell_15m and day4_sell_gate and confluence_pure_sell_15m >= pure_confluence_required and dir_filter_sell and not inside_day_blocks and not is_day2_rsd_5m and not is_day3_rsd_5m
int confluence_day3_buy_30m = f_confluence_score_day3(baseline_buy_30m, buy_alignment_30m, buy_100pt_break_30m, buy_5m_confirm, eq_rejected_bull_30m, in_golden_window, is_gsd_day2_or_3, slope_bullish_30m, candle_above_emas_30m, rr_valid_buy_30m)
