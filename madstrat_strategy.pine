            else if currentTrend == "green"
                projected_prefix := currentPrefix
                projected_gsd := gsd_count + 1
            else
                projected_prefix := "GD Day "
                projected_gsd := 1
        else
            if currentTrend == "green"
                projected_prefix := gsd_count >= 2 ? "RSD Day " : "RD Day "
                projected_rsd := 1
            else if currentTrend == "red"
                projected_prefix := currentPrefix
                projected_rsd := rsd_count + 1
            else
                projected_prefix := "RD Day "
                projected_rsd := 1
        if projected_gsd > 0
            rt_label := "LIVE: " + projected_prefix + str.tostring(projected_gsd)
            rt_bg := color.new(i_gsdLabelColor, 20)
        else if projected_rsd > 0
            rt_label := "LIVE: " + projected_prefix + str.tostring(projected_rsd)
            rt_bg := color.new(i_rsdLabelColor, 20)
    float rt_label_y = curr_day_high + curr_daily_range * 0.15
    int rt_label_x = time
    realtime_day_label := label.new(rt_label_x, rt_label_y, rt_label, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=rt_bg, textcolor=color.white, size=size.normal)
// SECTION 6A: SESSION BOX VISUAL SYSTEM
f_build_session_str(_startH, _startM, _endH, _endM) =>
    string startStr = str.format("{0,number,00}{1,number,00}", _startH, _startM)
    string endStr = str.format("{0,number,00}{1,number,00}", _endH, _endM)
    startStr + "-" + endStr
string sydneySessionStr = f_build_session_str(i_sydneyStartHour, i_sydneyStartMin, i_sydneyEndHour, i_sydneyEndMin)
string asianSessionStr = f_build_session_str(i_asianStartHour, i_asianStartMin, i_asianEndHour, i_asianEndMin)
string londonSessionStr = f_build_session_str(i_londonStartHour, i_londonStartMin, i_londonEndHour, i_londonEndMin)
string nySessionStr = f_build_session_str(i_nyStartHour, i_nyStartMin, i_nyEndHour, i_nyEndMin)
bool inSydneyBox = not na(time(timeframe.period, sydneySessionStr, tz_effective))
bool inAsianBox = not na(time(timeframe.period, asianSessionStr, tz_effective))
bool inLondonBox = not na(time(timeframe.period, londonSessionStr, tz_effective))
bool inNYBox = not na(time(timeframe.period, nySessionStr, tz_effective))
bool sydneyStart = inSydneyBox and not inSydneyBox[1]
bool sydneyEnd = not inSydneyBox and inSydneyBox[1]
bool asianStart = inAsianBox and not inAsianBox[1]
bool asianEnd = not inAsianBox and inAsianBox[1]
bool londonStart = inLondonBox and not inLondonBox[1]
bool londonEnd = not inLondonBox and inLondonBox[1]
bool nyStart = inNYBox and not inNYBox[1]
bool nyEnd = not inNYBox and inNYBox[1]
var float boxHigh_sydney = na
var float boxLow_sydney = na
var int boxStart_sydney = na
var int boxStartBar_sydney = na
var float boxHigh_asian = na
var float boxLow_asian = na
var int boxStart_asian = na
var int boxStartBar_asian = na
var float boxHigh_london = na
var float boxLow_london = na
var int boxStart_london = na
var int boxStartBar_london = na
var float boxHigh_ny = na
var float boxLow_ny = na
var int boxStart_ny = na
var int boxStartBar_ny = na
if sydneyStart
    boxHigh_sydney := high
    boxLow_sydney := low
    boxStart_sydney := time
    boxStartBar_sydney := bar_index
else if inSydneyBox
    boxHigh_sydney := math.max(nz(boxHigh_sydney, high), high)
    boxLow_sydney := math.min(nz(boxLow_sydney, low), low)
if asianStart
    boxHigh_asian := high
    boxLow_asian := low
    boxStart_asian := time
    boxStartBar_asian := bar_index
else if inAsianBox
    boxHigh_asian := math.max(nz(boxHigh_asian, high), high)
    boxLow_asian := math.min(nz(boxLow_asian, low), low)
if londonStart
    boxHigh_london := high
    boxLow_london := low
    boxStart_london := time
    boxStartBar_london := bar_index
else if inLondonBox
    boxHigh_london := math.max(nz(boxHigh_london, high), high)
    boxLow_london := math.min(nz(boxLow_london, low), low)
if nyStart
    boxHigh_ny := high
    boxLow_ny := low
    boxStart_ny := time
    boxStartBar_ny := bar_index
else if inNYBox
    boxHigh_ny := math.max(nz(boxHigh_ny, high), high)
    boxLow_ny := math.min(nz(boxLow_ny, low), low)
var array<box> boxes_sydney = array.new_box(0)
var array<box> boxes_asian = array.new_box(0)
var array<box> boxes_london = array.new_box(0)
var array<box> boxes_ny = array.new_box(0)
var array<label> labels_sydney = array.new_label(0)
var array<label> labels_asian = array.new_label(0)
var array<label> labels_london = array.new_label(0)
var array<label> labels_ny = array.new_label(0)
var array<line> midlines_sydney = array.new_line(0)
var array<line> midlines_asian = array.new_line(0)
var array<line> midlines_london = array.new_line(0)
var array<line> midlines_ny = array.new_line(0)
var box liveBox_sydney = na
var box liveBox_asian = na
var box liveBox_london = na
var box liveBox_ny = na
var label liveLabel_sydney = na
var label liveLabel_asian = na
var label liveLabel_london = na
var label liveLabel_ny = na
var line liveMid_sydney = na
var line liveMid_asian = na
var line liveMid_london = na
var line liveMid_ny = na
f_get_session_label_size() =>
    switch i_sessionLabelSize
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        => size.tiny
f_draw_session_box(_show, _inSession, _sessionEnd, _boxHigh, _boxLow, _boxStart, _fillColor, _borderColor, _sessionName, _boxesArr, _labelsArr, _midlinesArr, _liveBox, _liveLabel, _liveMid) =>
    box newLiveBox = _liveBox
    label newLiveLabel = _liveLabel
    line newLiveMid = _liveMid
    if i_showSessionBoxes and _show
        box.delete(newLiveBox)
        label.delete(newLiveLabel)
        line.delete(newLiveMid)
        newLiveBox := na
        newLiveLabel := na
        newLiveMid := na
        if _inSession and not na(_boxHigh) and not na(_boxLow) and not na(_boxStart)
            newLiveBox := box.new(_boxStart, _boxHigh, time, _boxLow, xloc=xloc.bar_time, bgcolor=_fillColor, border_color=_borderColor, border_width=1)
            if i_sessionBoxLabels
                newLiveLabel := label.new(_boxStart, _boxHigh, _sessionName, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(_borderColor, 60), textcolor=color.white, size=f_get_session_label_size())
            if i_showSessionMidlines
                float mid = (_boxHigh + _boxLow) / 2
                newLiveMid := line.new(_boxStart, mid, time, mid, xloc=xloc.bar_time, color=_borderColor, style=line.style_dashed, width=1)
        if _sessionEnd and not na(_boxHigh) and not na(_boxLow) and not na(_boxStart)
            box completedBox = box.new(_boxStart, _boxHigh, time, _boxLow, xloc=xloc.bar_time, bgcolor=_fillColor, border_color=_borderColor, border_width=1)
            array.push(_boxesArr, completedBox)
            if i_sessionBoxLabels
                label completedLabel = label.new(_boxStart, _boxHigh, _sessionName, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(_borderColor, 60), textcolor=color.white, size=f_get_session_label_size())
                array.push(_labelsArr, completedLabel)
            if i_showSessionMidlines
                float mid = (_boxHigh + _boxLow) / 2
                line completedMid = line.new(_boxStart, mid, time, mid, xloc=xloc.bar_time, color=_borderColor, style=line.style_dashed, width=1)
                array.push(_midlinesArr, completedMid)
            while array.size(_boxesArr) > i_sessionBoxCount
                box.delete(array.shift(_boxesArr))
            while array.size(_labelsArr) > i_sessionBoxCount
                label.delete(array.shift(_labelsArr))
            while array.size(_midlinesArr) > i_sessionBoxCount
                line.delete(array.shift(_midlinesArr))
    [newLiveBox, newLiveLabel, newLiveMid]
[tmpBox_syd, tmpLabel_syd, tmpMid_syd] = f_draw_session_box(i_showSydneyBox, inSydneyBox, sydneyEnd, boxHigh_sydney, boxLow_sydney, boxStart_sydney, i_sydneyBoxColor, i_sydneyBorderColor, "Sydney", boxes_sydney, labels_sydney, midlines_sydney, liveBox_sydney, liveLabel_sydney, liveMid_sydney)
liveBox_sydney := tmpBox_syd
liveLabel_sydney := tmpLabel_syd
liveMid_sydney := tmpMid_syd
[tmpBox_asi, tmpLabel_asi, tmpMid_asi] = f_draw_session_box(i_showAsianBox, inAsianBox, asianEnd, boxHigh_asian, boxLow_asian, boxStart_asian, i_asianBoxColor, i_asianBorderColor, "Asian", boxes_asian, labels_asian, midlines_asian, liveBox_asian, liveLabel_asian, liveMid_asian)
liveBox_asian := tmpBox_asi
liveLabel_asian := tmpLabel_asi
liveMid_asian := tmpMid_asi
[tmpBox_lon, tmpLabel_lon, tmpMid_lon] = f_draw_session_box(i_showLondonBox, inLondonBox, londonEnd, boxHigh_london, boxLow_london, boxStart_london, i_londonBoxColor, i_londonBorderColor, "London", boxes_london, labels_london, midlines_london, liveBox_london, liveLabel_london, liveMid_london)
liveBox_london := tmpBox_lon
liveLabel_london := tmpLabel_lon
liveMid_london := tmpMid_lon
[tmpBox_ny, tmpLabel_ny, tmpMid_ny] = f_draw_session_box(i_showNYBox, inNYBox, nyEnd, boxHigh_ny, boxLow_ny, boxStart_ny, i_nyBoxColor, i_nyBorderColor, "New York", boxes_ny, labels_ny, midlines_ny, liveBox_ny, liveLabel_ny, liveMid_ny)
liveBox_ny := tmpBox_ny
liveLabel_ny := tmpLabel_ny
liveMid_ny := tmpMid_ny
string activeSessionName = inNYBox ? "New York" : inLondonBox ? "London" : inAsianBox ? "Asian" : inSydneyBox ? "Sydney" : "Off-Session"
float activeSessionHigh = inNYBox ? boxHigh_ny : inLondonBox ? boxHigh_london : inAsianBox ? boxHigh_asian : inSydneyBox ? boxHigh_sydney : na
float activeSessionLow = inNYBox ? boxLow_ny : inLondonBox ? boxLow_london : inAsianBox ? boxLow_asian : inSydneyBox ? boxLow_sydney : na
float activeSessionMid = not na(activeSessionHigh) and not na(activeSessionLow) ? (activeSessionHigh + activeSessionLow) / 2 : na
float activeSessionRange = not na(activeSessionHigh) and not na(activeSessionLow) ? activeSessionHigh - activeSessionLow : na
f_get_hl_line_style() =>
    switch i_sessionHLStyle
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        =>         line.style_dashed
var line liveHL_syd_h = na, var line liveHL_syd_l = na
var line liveHL_asi_h = na, var line liveHL_asi_l = na
var line liveHL_lon_h = na, var line liveHL_lon_l = na
var line liveHL_ny_h  = na, var line liveHL_ny_l  = na
var array<line> hlLines_sydney  = array.new_line(0)
var array<line> hlLines_asian   = array.new_line(0)
var array<line> hlLines_london  = array.new_line(0)
var array<line> hlLines_ny      = array.new_line(0)
f_draw_session_hl(_show, _inSession, _sessionEnd, _boxHigh, _boxLow, _boxStart, _hColor, _lColor, _liveH, _liveL, _linesArr) =>
    line newH = _liveH
    line newL = _liveL
    if i_showSessionBoxes and i_showSessionHL and _show
        line.delete(newH)
        line.delete(newL)
        newH := na
        newL := na
        if _inSession and not na(_boxHigh) and not na(_boxLow) and not na(_boxStart)
            int x2_hl = time + (4 * 60 * 60 * 1000)
            newH := line.new(_boxStart, _boxHigh, x2_hl, _boxHigh, xloc=xloc.bar_time, color=_hColor, style=f_get_hl_line_style(), width=i_sessionHLWidth)
            newL := line.new(_boxStart, _boxLow, x2_hl, _boxLow, xloc=xloc.bar_time, color=_lColor, style=f_get_hl_line_style(), width=i_sessionHLWidth)
        if _sessionEnd and not na(_boxHigh) and not na(_boxLow) and not na(_boxStart)
            int x2_end = time + (12 * 60 * 60 * 1000)
            line compH = line.new(_boxStart, _boxHigh, x2_end, _boxHigh, xloc=xloc.bar_time, color=_hColor, style=f_get_hl_line_style(), width=i_sessionHLWidth)
            line compL = line.new(_boxStart, _boxLow, x2_end, _boxLow, xloc=xloc.bar_time, color=_lColor, style=f_get_hl_line_style(), width=i_sessionHLWidth)
            array.push(_linesArr, compH)
            array.push(_linesArr, compL)
            while array.size(_linesArr) > i_sessionBoxCount * 2
                line.delete(array.shift(_linesArr))
    [newH, newL]
[tmpHL_syd_h, tmpHL_syd_l] = f_draw_session_hl(i_showSydneyBox, inSydneyBox, sydneyEnd, boxHigh_sydney, boxLow_sydney, boxStart_sydney, i_sydneyHColor, i_sydneyLColor, liveHL_syd_h, liveHL_syd_l, hlLines_sydney)
liveHL_syd_h := tmpHL_syd_h
liveHL_syd_l := tmpHL_syd_l
[tmpHL_asi_h, tmpHL_asi_l] = f_draw_session_hl(i_showAsianBox, inAsianBox, asianEnd, boxHigh_asian, boxLow_asian, boxStart_asian, i_asianHColor, i_asianLColor, liveHL_asi_h, liveHL_asi_l, hlLines_asian)
liveHL_asi_h := tmpHL_asi_h
liveHL_asi_l := tmpHL_asi_l
[tmpHL_lon_h, tmpHL_lon_l] = f_draw_session_hl(i_showLondonBox, inLondonBox, londonEnd, boxHigh_london, boxLow_london, boxStart_london, i_londonHColor, i_londonLColor, liveHL_lon_h, liveHL_lon_l, hlLines_london)
liveHL_lon_h := tmpHL_lon_h
liveHL_lon_l := tmpHL_lon_l
[tmpHL_ny_h, tmpHL_ny_l] = f_draw_session_hl(i_showNYBox, inNYBox, nyEnd, boxHigh_ny, boxLow_ny, boxStart_ny, i_nyHColor, i_nyLColor, liveHL_ny_h, liveHL_ny_l, hlLines_ny)
liveHL_ny_h := tmpHL_ny_h
liveHL_ny_l := tmpHL_ny_l
string kzAsianStr = f_build_session_str(i_kzAsianStartHour, i_kzAsianStartMin, i_kzAsianEndHour, i_kzAsianEndMin)
string kzLondonStr = f_build_session_str(i_kzLondonStartHour, i_kzLondonStartMin, i_kzLondonEndHour, i_kzLondonEndMin)
string kzNYStr = f_build_session_str(i_kzNYStartHour, i_kzNYStartMin, i_kzNYEndHour, i_kzNYEndMin)
string kzLondonCloseStr = f_build_session_str(i_kzLCStartHour, i_kzLCStartMin, i_kzLCEndHour, i_kzLCEndMin)
bool inKZ_Asian = not na(time(timeframe.period, kzAsianStr, tz_effective))
bool inKZ_London = not na(time(timeframe.period, kzLondonStr, tz_effective))
bool inKZ_NY = not na(time(timeframe.period, kzNYStr, tz_effective))
bool inKZ_LondonClose = not na(time(timeframe.period, kzLondonCloseStr, tz_effective))
bool kzAsianStart = inKZ_Asian and not inKZ_Asian[1]
bool kzAsianEnd = not inKZ_Asian and inKZ_Asian[1]
bool kzLondonStart = inKZ_London and not inKZ_London[1]
bool kzLondonEnd = not inKZ_London and inKZ_London[1]
bool kzNYStart = inKZ_NY and not inKZ_NY[1]
bool kzNYEnd = not inKZ_NY and inKZ_NY[1]
bool kzLCStart = inKZ_LondonClose and not inKZ_LondonClose[1]
bool kzLCEnd = not inKZ_LondonClose and inKZ_LondonClose[1]
var float kzHigh_Asian = na
var float kzLow_Asian = na
var float kzHigh_London = na
var float kzLow_London = na
var float kzHigh_NY = na
var float kzLow_NY = na
var float kzHigh_LC = na
var float kzLow_LC = na
if kzAsianStart
    kzHigh_Asian := high
    kzLow_Asian := low
else if inKZ_Asian
    kzHigh_Asian := math.max(nz(kzHigh_Asian, high), high)
    kzLow_Asian := math.min(nz(kzLow_Asian, low), low)
if kzLondonStart
    kzHigh_London := high
    kzLow_London := low
else if inKZ_London
    kzHigh_London := math.max(nz(kzHigh_London, high), high)
    kzLow_London := math.min(nz(kzLow_London, low), low)
if kzNYStart
    kzHigh_NY := high
    kzLow_NY := low
else if inKZ_NY
    kzHigh_NY := math.max(nz(kzHigh_NY, high), high)
    kzLow_NY := math.min(nz(kzLow_NY, low), low)
if kzLCStart
    kzHigh_LC := high
    kzLow_LC := low
else if inKZ_LondonClose
    kzHigh_LC := math.max(nz(kzHigh_LC, high), high)
    kzLow_LC := math.min(nz(kzLow_LC, low), low)
bool inAnyKillzone = inKZ_Asian or inKZ_London or inKZ_NY or inKZ_LondonClose
string activeKillzoneName = inKZ_NY ? "NY Killzone" : inKZ_London ? "London Killzone" : inKZ_LondonClose ? "London Close KZ" : inKZ_Asian ? "Asian Killzone" : "None"
float activeKZHigh = inKZ_NY ? kzHigh_NY : inKZ_London ? kzHigh_London : inKZ_LondonClose ? kzHigh_LC : inKZ_Asian ? kzHigh_Asian : na
float activeKZLow = inKZ_NY ? kzLow_NY : inKZ_London ? kzLow_London : inKZ_LondonClose ? kzLow_LC : inKZ_Asian ? kzLow_Asian : na
float activeKZMid = not na(activeKZHigh) and not na(activeKZLow) ? (activeKZHigh + activeKZLow) / 2 : na
color kzBgColor = na
if i_showKillzones
    if i_showKZ_NY and inKZ_NY
        kzBgColor := color.new(i_kzNYColor, i_killzoneOpacity)
    else if i_showKZ_London and inKZ_London
        kzBgColor := color.new(i_kzLondonColor, i_killzoneOpacity)
    else if i_showKZ_LondonClose and inKZ_LondonClose
        kzBgColor := color.new(i_kzLondonCloseColor, i_killzoneOpacity)
    else if i_showKZ_Asian and inKZ_Asian
        kzBgColor := color.new(i_kzAsianColor, i_killzoneOpacity)
f_get_daily_range() => high - low
float daily_range_prev = request.security(syminfo.tickerid, "D", f_get_daily_range()[1], lookahead=barmerge.lookahead_off)
[d_open, d_high, d_low, d_close, d_open_prev, d_close_prev] = request.security(syminfo.tickerid, "D", [open, high, low, close, open[1], close[1]], lookahead=barmerge.lookahead_off)
var array<float> daily_ranges = array.new_float(0)
var float calculated_adr = na
bool new_trading_day = ta.change(time("D")) != 0
if new_trading_day and not na(daily_range_prev)
    array.push(daily_ranges, daily_range_prev)
    while array.size(daily_ranges) > i_adrPeriod
        array.shift(daily_ranges)
    if array.size(daily_ranges) > 0
        calculated_adr := array.avg(daily_ranges)
float adr_anchor = na
if i_adrAnchor == "Daily Open"
    adr_anchor := d_open
else if i_adrAnchor == "Previous Close"
    adr_anchor := d_close_prev
else if i_adrAnchor == "Midnight Open"
    adr_anchor := running_daily_open
if na(adr_anchor)
    adr_anchor := d_open
float adr_half = nz(calculated_adr, 0) / 2
float adr_upper = not na(adr_anchor) and not na(calculated_adr) ? adr_anchor + adr_half : na
float adr_lower = not na(adr_anchor) and not na(calculated_adr) ? adr_anchor - adr_half : na
float adr_mid = adr_anchor
float today_range = running_daily_high - running_daily_low
float adr_pct_used = not na(calculated_adr) and calculated_adr > 0 ? (today_range / calculated_adr) * 100 : na
bool adr_upper_hit = not na(adr_upper) and high >= adr_upper
bool adr_lower_hit = not na(adr_lower) and low <= adr_lower
bool adr_exhausted = adr_upper_hit or adr_lower_hit
bool adr_filter_ok = not i_enableADRFilter or na(adr_pct_used) or (adr_pct_used < i_adrFilterThreshold)
var bool adr_upper_hit_today = false
var bool adr_lower_hit_today = false
if new_trading_day
    adr_upper_hit_today := false
    adr_lower_hit_today := false
if adr_upper_hit and not adr_upper_hit_today
    adr_upper_hit_today := true
if adr_lower_hit and not adr_lower_hit_today
    adr_lower_hit_today := true
f_adr_line_style() =>
    switch i_adrLineStyle
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dashed
var line adr_upper_line = na
var line adr_lower_line = na
var line adr_mid_line = na
var linefill adr_fill = na
var label adr_upper_label = na
var label adr_lower_label = na
var label adr_mid_label = na
if i_showADR and barstate.islast and not na(adr_upper) and not na(adr_lower)
    line.delete(adr_upper_line)
    line.delete(adr_lower_line)
    line.delete(adr_mid_line)
    linefill.delete(adr_fill)
    label.delete(adr_upper_label)
    label.delete(adr_lower_label)
    label.delete(adr_mid_label)
    int line_start = running_daily_time
    int line_end = i_extendADRLines ? time + (4 * 60 * 60 * 1000) : time
    adr_upper_line := line.new(line_start, adr_upper, line_end, adr_upper, xloc=xloc.bar_time, color=i_adrUpperColor, width=i_adrLineWidth, style=f_adr_line_style())
    adr_lower_line := line.new(line_start, adr_lower, line_end, adr_lower, xloc=xloc.bar_time, color=i_adrLowerColor, width=i_adrLineWidth, style=f_adr_line_style())
    if i_showADRMidline
        adr_mid_line := line.new(line_start, adr_mid, line_end, adr_mid, xloc=xloc.bar_time, color=i_adrMidColor, width=1, style=line.style_dotted)
    if i_showADRFill
        adr_fill := linefill.new(adr_upper_line, adr_lower_line, i_adrFillColor)
    if i_showADRLabels
        string upper_text = "ADR+" + (adr_upper_hit_today ? " ✓" : "")
        string lower_text = "ADR-" + (adr_lower_hit_today ? " ✓" : "")
        string mid_text = "ADR Mid"
        adr_upper_label := label.new(line_end, adr_upper, upper_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_adrUpperColor, 50), textcolor=color.white, size=size.small)
        adr_lower_label := label.new(line_end, adr_lower, lower_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_adrLowerColor, 50), textcolor=color.white, size=size.small)
        if i_showADRMidline
            adr_mid_label := label.new(line_end, adr_mid, mid_text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_adrMidColor, 50), textcolor=color.white, size=size.tiny)
plotshape(i_showADR and i_showADRHitMarker and adr_upper_hit and not adr_upper_hit[1], "ADR Upper Hit", shape.xcross, location.abovebar, i_adrUpperColor, size=size.small)
plotshape(i_showADR and i_showADRHitMarker and adr_lower_hit and not adr_lower_hit[1], "ADR Lower Hit", shape.xcross, location.belowbar, i_adrLowerColor, size=size.small)
float adr_value = calculated_adr
float adr_upper_distance = not na(adr_upper) ? adr_upper - close : na
float adr_lower_distance = not na(adr_lower) ? close - adr_lower : na
