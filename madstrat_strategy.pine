var line pwh_line = na
var line pwl_line = na
var line pweq_line = na
var line cwh_line = na
var line cwl_line = na
var line cweq_line = na
if i_showWeeklyLevels and i_showPrevWeek and not na(prev_week_high) and not na(prev_week_low) and not na(previous_week_start_time) and not na(current_week_start_time)
    line.delete(pwh_line)
    line.delete(pwl_line)
    line.delete(pweq_line)
    int minutes_diff = sunday_open_minutes - standard_rollover_minutes
    int x1 = previous_week_start_time - (minutes_diff * 60 * 1000)
    int x2 = current_week_start_time + (weeklyLevelDaysOffset * 24 * 60 * 60 * 1000)
    pwh_line := line.new(x1, prev_week_high, x2, prev_week_high, xloc=xloc.bar_time, color=i_prevWeekColor, width=i_prevWeekWidth)
    pwl_line := line.new(x1, prev_week_low, x2, prev_week_low, xloc=xloc.bar_time, color=i_prevWeekColor, width=i_prevWeekWidth)
    pweq_line := line.new(x1, prev_week_eq, x2, prev_week_eq, xloc=xloc.bar_time, color=i_pweqLineColor, style=line.style_dotted, width=i_pweqLineWidth)
if i_showWeeklyLevels and i_showCurrWeek and not na(current_week_start_time)
    line.delete(cwh_line)
    line.delete(cwl_line)
    line.delete(cweq_line)
    if not na(curr_week_high) and not na(curr_week_low)
        int minutes_diff = sunday_open_minutes - standard_rollover_minutes
        int current_week_x1 = current_week_start_time - (minutes_diff * 60 * 1000)
        int current_week_end = current_week_start_time + (weeklyLevelDaysOffset * 24 * 60 * 60 * 1000)
        cwh_line := line.new(current_week_x1, curr_week_high, current_week_end, curr_week_high, xloc=xloc.bar_time, color=i_currWeekColor, style=line.style_dashed, width=i_currWeekWidth)
        cwl_line := line.new(current_week_x1, curr_week_low, current_week_end, curr_week_low, xloc=xloc.bar_time, color=i_currWeekColor, style=line.style_dashed, width=i_currWeekWidth)
        cweq_line := line.new(current_week_x1, curr_week_eq, current_week_end, curr_week_eq, xloc=xloc.bar_time, color=i_currWeekColor, style=line.style_dotted, width=1)
var label pwh_label = na
var label pweq_label = na
var label pwl_label = na
var label wh_label = na
var label weq_label = na
var label wl_label = na
if barstate.islast and i_showWeeklyLevels and i_showWeeklyLabels
    int current_week_end = current_week_start_time + (weeklyLevelDaysOffset * 24 * 60 * 60 * 1000)
    if i_showPrevWeek and not na(prev_week_high)
        label.delete(pwh_label)
        pwh_label := label.new(current_week_end, prev_week_high, "PWH", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
    if i_showPrevWeek and not na(prev_week_eq)
        label.delete(pweq_label)
        pweq_label := label.new(current_week_end, prev_week_eq, "PWEQ", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
    if i_showPrevWeek and not na(prev_week_low)
        label.delete(pwl_label)
        pwl_label := label.new(current_week_end, prev_week_low, "PWL", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
    if i_showCurrWeek and not na(curr_week_high)
        label.delete(wh_label)
        wh_label := label.new(current_week_end, curr_week_high, "WH", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
    if i_showCurrWeek and not na(curr_week_eq)
        label.delete(weq_label)
        weq_label := label.new(current_week_end, curr_week_eq, "WEQ", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
    if i_showCurrWeek and not na(curr_week_low)
        label.delete(wl_label)
        wl_label := label.new(current_week_end, curr_week_low, "WL", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=i_weeklyLabelColor, size=f_get_label_size(i_weeklyLabelSize))
bool is_gsd_day2_or_3_15m = is_gsd_day2_or_3
bool is_rsd_day2_or_3_15m = is_rsd_day2_or_3
bool is_gsd_day2_or_3_30m = is_gsd_day2_or_3
bool is_rsd_day2_or_3_30m = is_rsd_day2_or_3
bool final_buy_15m = final_day2_buy_15m or final_day3_buy_15m or final_pure_buy_15m
bool final_sell_15m = final_day2_sell_15m or final_day3_sell_15m or final_pure_sell_15m
bool final_buy_30m = final_day2_buy_30m or final_day3_buy_30m or final_pure_buy_30m
bool final_sell_30m = final_day2_sell_30m or final_day3_sell_30m or final_pure_sell_30m
var int signal_count_today = 0
int i_maxSignalsPerDay = 10
if is_rollover
    signal_count_today := 0
if buy_signal_fired or sell_signal_fired
    signal_count_today += 1
int active_trade_count = math.abs(strategy.position_size) > 0 ? 1 : 0
int i_maxConcurrentTrades = 3
int ema_trend_15m_h1 = htf_1hr_ema9 > htf_1hr_ema50 ? 1 : htf_1hr_ema9 < htf_1hr_ema50 ? -1 : 0
// SECTION 12A: TABLES (Confluence & Status) - REFACTORED INTO FUNCTIONS
const int SYS_15   = 15
const int SYS_30   = 30
const int SYS_4H   = 240
const int SYS_DPLS = 1440
f_chart_tf_minutes() =>
    float mins = na
    if timeframe.isseconds
        mins := timeframe.multiplier / 60.0
    else if timeframe.isminutes
        mins := timeframe.multiplier * 1.0
    else if timeframe.isdaily
        mins := 1440.0
    else if timeframe.isweekly
        mins := 10080.0
    else if timeframe.ismonthly
        mins := 43200.0
    mins
f_auto_system() =>
    float tfm = f_chart_tf_minutes()
    int sys = SYS_15
    if na(tfm)
        sys := SYS_15
    else if tfm <= 5
        sys := SYS_15
    else if tfm == 15
        sys := SYS_15
    else if tfm == 30
        sys := SYS_30
    else if tfm == 60
        sys := SYS_15
    else if tfm == 120
        sys := SYS_30
    else if tfm == 240
        sys := SYS_4H
    else if tfm >= 1440
        sys := SYS_DPLS
    else if tfm < 30
        sys := SYS_15
    else if tfm < 240
        sys := SYS_30
    else
        sys := SYS_4H
    string name = sys == SYS_15 ? "15m+1hr+4hr" : sys == SYS_30 ? "30m+2hr+4hr" : sys == SYS_4H ? "4hr+12hr+daily" : "1hr+2hr+4hr"
    [sys, name]
f_selected_system(string mode) =>
    if mode == "15m System"
        [SYS_15, "15m+1hr+4hr"]
    else if mode == "30m System"
        [SYS_30, "30m+2hr+4hr"]
    else
        f_auto_system()
f_draw_confluence_table(table old_tbl) =>
    table.delete(old_tbl)
    string tblSize = f_get_table_text_size(i_tableTextSize)
    bool show_full = i_tableMode == "Full" or i_tableMode == "Confluence Only"
    bool show_compact = i_tableMode == "Compact"
    int conf_rows = show_compact ? 6 : 22
    table conf_tbl = table.new(position.top_right, 3, conf_rows, bgcolor=color.new(color.black, 50), border_color=color.white, border_width=1)
    [system_id, system_name] = f_selected_system(i_confluenceTableSystem)
    string conf_header = show_compact ? "Confluence" : "Confluence: " + system_name
    table.cell(conf_tbl, 0, 0, conf_header, bgcolor=color.gray, text_color=color.white, text_size=tblSize)
    table.cell(conf_tbl, 1, 0, "Status", bgcolor=color.gray, text_color=color.white, text_size=tblSize)
    table.cell(conf_tbl, 2, 0, "Pts", bgcolor=color.gray, text_color=color.white, text_size=tblSize)
    bool rt_inside_conf = running_daily_high < pdh and running_daily_low > pdl
    bool is_inside_now = inside_day_freeze or rt_inside_conf
    bool rt_clean_bull_conf = not na(prev_week_high) and running_daily_high > prev_week_high and close > prev_week_high and not week_has_clean_breakout_high
    bool rt_clean_bear_conf = not na(prev_week_low) and running_daily_low < prev_week_low and close < prev_week_low and not week_has_clean_breakout_low
    int live_gsd_count = 0
    int live_rsd_count = 0
    bool live_is_gsd = false
    bool live_is_rsd = false
    if not is_inside_now
        if rt_clean_bull_conf or rt_clean_bear_conf
            if rt_clean_bull_conf
                live_gsd_count := 1
                live_is_gsd := true
            else
                live_rsd_count := 1
                live_is_rsd := true
        else
            bool rt_is_green = close > running_daily_open
            if rt_is_green
                if currentTrend == "red"
                    live_is_gsd := rsd_count >= 2
                    live_gsd_count := 1
                else if currentTrend == "green"
                    live_is_gsd := str.contains(currentPrefix, "GSD")
                    live_gsd_count := gsd_count + 1
                else
                    live_gsd_count := 1
            else
                if currentTrend == "green"
                    live_is_rsd := gsd_count >= 2
                    live_rsd_count := 1
                else if currentTrend == "red"
                    live_is_rsd := str.contains(currentPrefix, "RSD")
                    live_rsd_count := rsd_count + 1
                else
                    live_rsd_count := 1
    bool live_day2_or_3 = (live_is_gsd and (live_gsd_count == 2 or live_gsd_count == 3)) or (live_is_rsd and (live_rsd_count == 2 or live_rsd_count == 3))
    bool is_buy_direction = live_is_gsd or (not live_is_rsd)
    bool is_day3_signal = live_is_gsd or live_is_rsd
    bool baseline = system_id == SYS_15 ? (is_buy_direction ? baseline_buy_15m : baseline_sell_15m) : (is_buy_direction ? baseline_buy_30m : baseline_sell_30m)
    bool alignment = system_id == SYS_15 ? (is_buy_direction ? buy_alignment_15m : sell_alignment_15m) : (is_buy_direction ? buy_alignment_30m : sell_alignment_30m)
    bool hundred_pt = system_id == SYS_15 ? (is_buy_direction ? buy_100pt_break_15m : sell_100pt_break_15m) : (is_buy_direction ? buy_100pt_break_30m : sell_100pt_break_30m)
    bool five_m = is_buy_direction ? buy_5m_confirm : sell_5m_confirm
    bool eq_touch = system_id == SYS_15 ? (is_buy_direction ? eq_rejected_bull_15m : eq_rejected_bear_15m) : (is_buy_direction ? eq_rejected_bull_30m : eq_rejected_bear_30m)
    bool slope = system_id == SYS_15 ? (is_buy_direction ? slope_bullish_15m : slope_bearish_15m) : (is_buy_direction ? slope_bullish_30m : slope_bearish_30m)
    bool candle_emas = system_id == SYS_15 ? (is_buy_direction ? candle_above_emas_15m : candle_below_emas_15m) : (is_buy_direction ? candle_above_emas_30m : candle_below_emas_30m)
    bool rr_ok = system_id == SYS_15 ? (is_buy_direction ? rr_valid_buy_15m : rr_valid_sell_15m) : (is_buy_direction ? rr_valid_buy_30m : rr_valid_sell_30m)
    float current_rr = system_id == SYS_15 ? (is_buy_direction ? potential_rr_buy_15m : potential_rr_sell_15m) : (is_buy_direction ? potential_rr_buy_30m : potential_rr_sell_30m)
    bool is_a_setup = system_id == SYS_15 ? (is_buy_direction ? is_a_setup_buy_15m : is_a_setup_sell_15m) : (is_buy_direction ? is_a_setup_buy_30m : is_a_setup_sell_30m)
    bool is_b_setup = system_id == SYS_15 ? (is_buy_direction ? is_b_setup_buy_15m : is_b_setup_sell_15m) : (is_buy_direction ? is_b_setup_buy_30m : is_b_setup_sell_30m)
    bool signal_candle_correct = system_id == SYS_15 ? (is_buy_direction ? (fresh_baseline_buy_15m or bars_since_baseline_touch_buy_15m <= 1) : (fresh_baseline_sell_15m or bars_since_baseline_touch_sell_15m <= 1)) : (is_buy_direction ? (fresh_baseline_buy_30m or bars_since_baseline_touch_buy_30m <= 1) : (fresh_baseline_sell_30m or bars_since_baseline_touch_sell_30m <= 1))
    bool htf_rejected = system_id == SYS_15 ? (is_buy_direction ? htf_rejection_blocks_buy_15m : htf_rejection_blocks_sell_15m) : (is_buy_direction ? htf_rejection_blocks_buy_30m : htf_rejection_blocks_sell_30m)
    int total_score = 0
    total_score += baseline ? 2 : 0
    total_score += alignment ? 1 : 0
    total_score += hundred_pt ? 1 : 0
    total_score += five_m ? 1 : 0
    total_score += eq_touch ? 2 : 0
    total_score += in_golden_window ? 1 : 0
    total_score += in_session_overlap ? 1 : 0
    total_score += slope ? 1 : 0
    total_score += candle_emas ? 1 : 0
    total_score += rr_ok ? 1 : 0
    total_score += (is_day3_signal and live_day2_or_3) ? 1 : 0
    int max_score = is_day3_signal ? 12 : 11
    if i_enableOverlapConfluence
        max_score += 1
    int required_score = is_day3_signal ? required_confluence_buy : pure_confluence_required
    bool score_met = total_score >= required_score
    int row = 1
    if show_compact
        string setup_str = is_a_setup ? "TYPE A" : is_b_setup ? "TYPE B" : "---"
        color setup_col = is_a_setup ? color.green : is_b_setup ? color.orange : color.gray
        table.cell(conf_tbl, 0, row, "Setup Type", text_size=tblSize)
        table.cell(conf_tbl, 1, row, setup_str, bgcolor=setup_col, text_color=color.white, text_size=tblSize)
        table.cell(conf_tbl, 2, row, is_a_setup ? "10%" : is_b_setup ? "5%" : "-", bgcolor=setup_col, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "Score", text_size=tblSize)
        table.cell(conf_tbl, 1, row, str.tostring(total_score) + "/" + str.tostring(max_score), text_size=tblSize)
        table.cell(conf_tbl, 2, row, "≥" + str.tostring(required_score), bgcolor=score_met ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "HTF Block", text_size=tblSize)
        table.cell(conf_tbl, 1, row, htf_rejected ? "BLOCKED" : "Clear", bgcolor=htf_rejected ? color.red : color.green, text_color=color.white, text_size=tblSize)
        table.cell(conf_tbl, 2, row, htf_rejected ? "✗" : "✓", bgcolor=htf_rejected ? color.red : color.green, text_color=color.white, text_size=tblSize)
        row += 1
        bool final_valid = score_met and not htf_rejected and (is_a_setup or is_b_setup)
        table.cell(conf_tbl, 0, row, "Status", text_size=tblSize)
        table.cell(conf_tbl, 1, row, final_valid ? "✓ VALID" : "✗ INVALID", bgcolor=final_valid ? color.green : color.red, text_color=color.white, text_size=tblSize)
        table.cell(conf_tbl, 2, row, "", bgcolor=final_valid ? color.green : color.red, text_size=tblSize)
    else
        table.cell(conf_tbl, 0, row, "1. Baseline Touch ★", text_size=tblSize)
        table.cell(conf_tbl, 1, row, baseline ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, baseline ? "+2" : "0", bgcolor=baseline ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "2. EMA Alignment", text_size=tblSize)
        table.cell(conf_tbl, 1, row, alignment ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, alignment ? "+1" : "0", bgcolor=alignment ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "3. 100pt Breakout", text_size=tblSize)
        table.cell(conf_tbl, 1, row, hundred_pt ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, hundred_pt ? "+1" : "0", bgcolor=hundred_pt ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "4. 5M Confirm", text_size=tblSize)
        table.cell(conf_tbl, 1, row, five_m ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, five_m ? "+1" : "0", bgcolor=five_m ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "5. EQ Rejection ★", text_size=tblSize)
        table.cell(conf_tbl, 1, row, eq_touch ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, eq_touch ? "+2" : "0", bgcolor=eq_touch ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "6. Golden Window", text_size=tblSize)
        table.cell(conf_tbl, 1, row, in_golden_window ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, in_golden_window ? "+1" : "0", bgcolor=in_golden_window ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "7. EMA Slope", text_size=tblSize)
        table.cell(conf_tbl, 1, row, slope ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, slope ? "+1" : "0", bgcolor=slope ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "8. Candle > EMAs", text_size=tblSize)
        table.cell(conf_tbl, 1, row, candle_emas ? "Yes" : "No", text_size=tblSize)
        table.cell(conf_tbl, 2, row, candle_emas ? "+1" : "0", bgcolor=candle_emas ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "9. Min RR (" + str.tostring(i_minRR, "#.#") + ":1)", text_size=tblSize)
        table.cell(conf_tbl, 1, row, str.tostring(current_rr, "#.##") + ":1", text_size=tblSize)
        table.cell(conf_tbl, 2, row, rr_ok ? "+1" : "0", bgcolor=rr_ok ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        if is_day3_signal
            table.cell(conf_tbl, 0, row, "10. Day 2/3 Active", text_size=tblSize)
            table.cell(conf_tbl, 1, row, live_day2_or_3 ? "Yes" : "No", text_size=tblSize)
            table.cell(conf_tbl, 2, row, live_day2_or_3 ? "+1" : "0", bgcolor=live_day2_or_3 ? color.green : color.red, text_color=color.white, text_size=tblSize)
            row += 1
        if i_enableOverlapConfluence
            string overlap_str = in_london_ny_overlap ? "LON/NY" : in_asian_london_overlap ? "ASIA/LON" : "None"
            table.cell(conf_tbl, 0, row, "11. Session Overlap", text_size=tblSize)
            table.cell(conf_tbl, 1, row, overlap_str, text_size=tblSize)
            table.cell(conf_tbl, 2, row, in_session_overlap ? "+1" : "0", bgcolor=in_session_overlap ? color.green : color.red, text_color=color.white, text_size=tblSize)
            row += 1
        table.cell(conf_tbl, 0, row, "Signal Candle", text_size=tblSize)
        string candle_str = is_buy_direction ? (signal_candle_correct ? "Bullish ✓" : "Wrong Color") : (signal_candle_correct ? "Bearish ✓" : "Wrong Color")
        table.cell(conf_tbl, 1, row, candle_str, text_size=tblSize)
        table.cell(conf_tbl, 2, row, signal_candle_correct ? "✓" : "✗", bgcolor=signal_candle_correct ? color.green : color.orange, text_color=color.white, text_size=tblSize)
        row += 1
        string setup_str = is_a_setup ? "TYPE A (All Aligned)" : is_b_setup ? "TYPE B (1-2 Against)" : "No Valid Setup"
        color setup_col = is_a_setup ? color.green : is_b_setup ? color.orange : color.red
        string risk_str = is_a_setup ? "10%/1%" : is_b_setup ? "5%/0.5%" : "---"
        table.cell(conf_tbl, 0, row, "Setup Type", text_size=tblSize)
        table.cell(conf_tbl, 1, row, setup_str, bgcolor=setup_col, text_color=color.white, text_size=tblSize)
        table.cell(conf_tbl, 2, row, risk_str, bgcolor=setup_col, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "HTF Rejection", text_size=tblSize)
        table.cell(conf_tbl, 1, row, htf_rejected ? "⚠ BLOCKED" : "Clear", text_size=tblSize)
        table.cell(conf_tbl, 2, row, htf_rejected ? "GATE" : "✓", bgcolor=htf_rejected ? color.red : color.green, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "Total Score", text_size=tblSize)
        table.cell(conf_tbl, 1, row, str.tostring(total_score) + " / " + str.tostring(max_score), text_size=tblSize)
        table.cell(conf_tbl, 2, row, score_met ? "✓" : "✗", bgcolor=score_met ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(conf_tbl, 0, row, "Required", text_size=tblSize)
        table.cell(conf_tbl, 1, row, "≥ " + str.tostring(required_score) + " pts", text_size=tblSize)
        table.cell(conf_tbl, 2, row, score_met ? "MET" : "NOT", bgcolor=score_met ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        bool final_valid = score_met and not htf_rejected and (is_a_setup or is_b_setup)
        string status_str = not (is_a_setup or is_b_setup) ? "NO SETUP" : htf_rejected ? "HTF BLOCKED" : not score_met ? "LOW CONFLUENCE" : "✓ VALID"
        table.cell(conf_tbl, 0, row, "FINAL STATUS", text_size=tblSize)
        table.cell(conf_tbl, 1, row, status_str, bgcolor=final_valid ? color.green : color.red, text_color=color.white, text_size=tblSize)
        table.cell(conf_tbl, 2, row, final_valid ? "GO" : "NO", bgcolor=final_valid ? color.green : color.red, text_color=color.white, text_size=tblSize)
    conf_tbl
f_draw_status_table(table old_tbl) =>
    table.delete(old_tbl)
    string tblSize = f_get_table_text_size(i_tableTextSize)
    bool show_full = i_tableMode == "Full" or i_tableMode == "Status Only"
    bool show_compact = i_tableMode == "Compact"
    int status_rows = show_compact ? 6 : 34
    table stat_tbl = table.new(position.top_left, 2, status_rows, bgcolor=color.new(color.black, 50), border_color=color.white, border_width=1)
    table.cell(stat_tbl, 0, 0, show_compact ? "MADSTRAT 2.0" : "MADSTRAT 2.0 STATUS", bgcolor=color.gray, text_color=color.white, text_size=tblSize)
    table.cell(stat_tbl, 1, 0, "", bgcolor=color.gray, text_size=tblSize)
    int row = 1
    bool rt_inside = running_daily_high < pdh and running_daily_low > pdl
    string day_label = ""
    color day_color = color.gray
    bool is_buy_direction = false
    bool status_clean_bull = not week_has_clean_breakout_high and not na(prev_week_high) and running_daily_high > prev_week_high and close > prev_week_high
    bool status_clean_bear = not week_has_clean_breakout_low and not na(prev_week_low) and running_daily_low < prev_week_low and close < prev_week_low
    bool can_status_fbr_bull = not week_has_fbr and not week_has_clean_breakout_low and not pwl_closed_through
    bool can_status_fbr_bear = not week_has_fbr and not week_has_clean_breakout_high and not pwh_closed_through
    bool status_bull_fbr = can_status_fbr_bull and not na(prev_week_low) and not na(prev_week_high) and running_daily_low < prev_week_low and close > prev_week_low and close < prev_week_high
    bool status_bear_fbr = can_status_fbr_bear and not na(prev_week_low) and not na(prev_week_high) and running_daily_high > prev_week_high and close < prev_week_high and close > prev_week_low
    if i_enforceFBRDirection
        status_bull_fbr := status_bull_fbr and (close > running_daily_open)
        status_bear_fbr := status_bear_fbr and (close < running_daily_open)
    if status_clean_bull
        day_label := "LIVE: CLEAN BULL BO"
        day_color := i_bullBreakoutColor
        is_buy_direction := true
    else if status_clean_bear
        day_label := "LIVE: CLEAN BEAR BO"
        day_color := i_bearBreakoutColor
        is_buy_direction := false
    else if inside_day_freeze or rt_inside
        // Inside Day always takes priority over FBR — freezes count
        day_label := "Inside Day"
        day_color := i_insideLabelColor
        is_buy_direction := currentTrend == "green"
    else if status_bull_fbr
        day_label := "LIVE: FBR - GSD Day 1"
        day_color := color.orange
        is_buy_direction := true
    else if status_bear_fbr
        day_label := "LIVE: FBR - RSD Day 1"
        day_color := color.orange
        is_buy_direction := false
    else
        bool rt_is_green = close > running_daily_open
        is_buy_direction := rt_is_green
        if rt_is_green
            if currentTrend == "red"
                day_label := rsd_count >= 2 ? "LIVE: GSD Day 1" : "LIVE: GD Day 1"
            else if currentTrend == "green"
                day_label := "LIVE: " + currentPrefix + str.tostring(gsd_count + 1)
            else
                day_label := "LIVE: GD Day 1"
            day_color := i_gsdLabelColor
        else
            if currentTrend == "green"
                day_label := gsd_count >= 2 ? "LIVE: RSD Day 1" : "LIVE: RD Day 1"
            else if currentTrend == "red"
                day_label := "LIVE: " + currentPrefix + str.tostring(rsd_count + 1)
            else
                day_label := "LIVE: RD Day 1"
            day_color := i_rsdLabelColor
    table.cell(stat_tbl, 0, row, "Day Type", text_size=tblSize)
    table.cell(stat_tbl, 1, row, day_label, bgcolor=day_color, text_color=color.white, text_size=tblSize)
    row += 1
    if show_compact
        bool any_buy = final_buy_15m or final_buy_30m
        bool any_sell = final_sell_15m or final_sell_30m
        table.cell(stat_tbl, 0, row, "Signal", text_size=tblSize)
        table.cell(stat_tbl, 1, row, any_buy ? "BUY" : any_sell ? "SELL" : "None", bgcolor=any_buy ? color.green : any_sell ? color.red : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
        bool show_15m = is_15m_chart or (not is_30m_chart)
        bool is_a = show_15m ? (is_buy_direction ? is_a_setup_buy_15m : is_a_setup_sell_15m) : (is_buy_direction ? is_a_setup_buy_30m : is_a_setup_sell_30m)
        bool is_b = show_15m ? (is_buy_direction ? is_b_setup_buy_15m : is_b_setup_sell_15m) : (is_buy_direction ? is_b_setup_buy_30m : is_b_setup_sell_30m)
        table.cell(stat_tbl, 0, row, "Setup", text_size=tblSize)
        table.cell(stat_tbl, 1, row, is_a ? "TYPE A" : is_b ? "TYPE B" : "---", bgcolor=is_a ? color.green : is_b ? color.orange : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "Golden", text_size=tblSize)
        table.cell(stat_tbl, 1, row, in_golden_window ? "ACTIVE" : "---", bgcolor=in_golden_window ? color.green : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
    else
        table.cell(stat_tbl, 0, row, "Power of 3", text_size=tblSize)
        table.cell(stat_tbl, 1, row, "Day " + str.tostring(power_of_3_day), text_size=tblSize)
        row += 1
        string sig_15m = final_day2_buy_15m ? (fbr_origin_cycle ? "FBR-D2 BUY" : "D2 BUY") : final_day3_buy_15m ? (fbr_origin_cycle ? "FBR-D3 BUY" : "D3 BUY") : final_pure_buy_15m ? "MAD BUY" :
                         final_day2_sell_15m ? (fbr_origin_cycle ? "FBR-D2 SELL" : "D2 SELL") : final_day3_sell_15m ? (fbr_origin_cycle ? "FBR-D3 SELL" : "D3 SELL") : final_pure_sell_15m ? "MAD SELL" : "None"
        color sig_15m_col = (final_day2_buy_15m or final_day3_buy_15m or final_pure_buy_15m) ? color.green :
                           (final_day2_sell_15m or final_day3_sell_15m or final_pure_sell_15m) ? color.red : color.gray
        table.cell(stat_tbl, 0, row, "15m System", text_size=tblSize)
        table.cell(stat_tbl, 1, row, sig_15m, bgcolor=sig_15m_col, text_color=color.white, text_size=tblSize)
        row += 1
        string sig_30m = final_day2_buy_30m ? (fbr_origin_cycle ? "FBR-D2 BUY" : "D2 BUY") : final_day3_buy_30m ? (fbr_origin_cycle ? "FBR-D3 BUY" : "D3 BUY") : final_pure_buy_30m ? "MAD BUY" :
                         final_day2_sell_30m ? (fbr_origin_cycle ? "FBR-D2 SELL" : "D2 SELL") : final_day3_sell_30m ? (fbr_origin_cycle ? "FBR-D3 SELL" : "D3 SELL") : final_pure_sell_30m ? "MAD SELL" : "None"
        color sig_30m_col = (final_day2_buy_30m or final_day3_buy_30m or final_pure_buy_30m) ? color.green :
                           (final_day2_sell_30m or final_day3_sell_30m or final_pure_sell_30m) ? color.red : color.gray
        table.cell(stat_tbl, 0, row, "30m System", text_size=tblSize)
        table.cell(stat_tbl, 1, row, sig_30m, bgcolor=sig_30m_col, text_color=color.white, text_size=tblSize)
        row += 1
        bool show_30m = is_30m_chart or timeframe.period == "120"
        bool is_a_buy_current = show_30m ? is_a_setup_buy_30m : is_a_setup_buy_15m
        bool is_a_sell_current = show_30m ? is_a_setup_sell_30m : is_a_setup_sell_15m
        bool is_b_buy_current = show_30m ? is_b_setup_buy_30m : is_b_setup_buy_15m
        bool is_b_sell_current = show_30m ? is_b_setup_sell_30m : is_b_setup_sell_15m
        bool is_a_setup_current = is_buy_direction ? is_a_buy_current : is_a_sell_current
        bool is_b_setup_current = is_buy_direction ? is_b_buy_current : is_b_sell_current
        string setup_type_str = is_a_setup_current ? "TYPE A (All Aligned)" : is_b_setup_current ? "TYPE B (1-2 Against)" : "No Valid Setup"
        color setup_type_col = is_a_setup_current ? color.green : is_b_setup_current ? color.orange : color.red
        table.cell(stat_tbl, 0, row, "Setup Grade", text_size=tblSize)
        table.cell(stat_tbl, 1, row, setup_type_str, bgcolor=setup_type_col, text_color=color.white, text_size=tblSize)
        row += 1
        string risk_str = is_a_setup_current ? (i_accountType == "Live" ? str.tostring(i_riskPercent_A_Live, "#.#") + "%" : str.tostring(i_riskPercent_A_Prop, "#.#") + "%") : is_b_setup_current ? (i_accountType == "Live" ? str.tostring(i_riskPercent_B_Live, "#.#") + "%" : str.tostring(i_riskPercent_B_Prop, "#.#") + "%") : "---"
        table.cell(stat_tbl, 0, row, "Risk Size", text_size=tblSize)
        table.cell(stat_tbl, 1, row, risk_str, bgcolor=setup_type_col, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "Golden Window", text_size=tblSize)
        table.cell(stat_tbl, 1, row, in_golden_window ? "ACTIVE" : "Inactive", bgcolor=in_golden_window ? color.green : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "Session Filter", text_size=tblSize)
        table.cell(stat_tbl, 1, row, session_filter_ok ? "PASS" : "BLOCKED", bgcolor=session_filter_ok ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        bool eq_active = eq_rejected_bull_15m or eq_rejected_bear_15m or eq_rejected_bull_30m or eq_rejected_bear_30m
        string eq_text = eq_rejected_bull_15m or eq_rejected_bull_30m ? "Bull ✓" : eq_rejected_bear_15m or eq_rejected_bear_30m ? "Bear ✓" : "None"
        table.cell(stat_tbl, 0, row, "EQ Rejection", text_size=tblSize)
        table.cell(stat_tbl, 1, row, eq_text, bgcolor=eq_active ? color.green : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
        bool htf_rej_15m = is_buy_direction ? htf_rejection_blocks_buy_15m : htf_rejection_blocks_sell_15m
        bool htf_rej_30m = is_buy_direction ? htf_rejection_blocks_buy_30m : htf_rejection_blocks_sell_30m
        bool htf_blocked = htf_rej_15m or htf_rej_30m
        table.cell(stat_tbl, 0, row, "HTF Rejection", text_size=tblSize)
        table.cell(stat_tbl, 1, row, htf_blocked ? "⚠ BLOCKED" : "Clear", bgcolor=htf_blocked ? color.red : color.green, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "HTF 1hr BL", text_size=tblSize)
        table.cell(stat_tbl, 1, row, htf_baseline_valid_15m ? "✓ (" + str.tostring(bars_since_htf_baseline_1hr) + " bars)" : "✗", bgcolor=htf_baseline_valid_15m ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "HTF 2hr BL", text_size=tblSize)
        table.cell(stat_tbl, 1, row, htf_baseline_valid_30m ? "✓ (" + str.tostring(bars_since_htf_baseline_2hr) + " bars)" : "✗", bgcolor=htf_baseline_valid_30m ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        string tf_label = show_30m ? "30m" : "15m"
        table.cell(stat_tbl, 0, row, "═══ " + tf_label + " TOUCHES ═══", bgcolor=color.new(color.yellow, 50), text_color=color.black, text_size=tblSize)
        table.cell(stat_tbl, 1, row, "", bgcolor=color.new(color.yellow, 50), text_size=tblSize)
        row += 1
        bool disp_baseline = show_30m ? (baseline_buy_30m or baseline_sell_30m) : (baseline_buy_15m or baseline_sell_15m)
        bool disp_stack = show_30m ? (stack_buy_30m or stack_sell_30m) : (stack_buy_15m or stack_sell_15m)
        bool disp_all_touched = show_30m ? all_levels_touched_buy_30m or all_levels_touched_sell_30m : all_levels_touched_buy_15m or all_levels_touched_sell_15m
        table.cell(stat_tbl, 0, row, "  50 EMA Touch", text_size=tblSize)
        table.cell(stat_tbl, 1, row, disp_baseline ? "✓" : "✗", bgcolor=disp_baseline ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "  Stack Aligned", text_size=tblSize)
        table.cell(stat_tbl, 1, row, disp_stack ? "✓" : "✗", bgcolor=disp_stack ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "  All Levels", text_size=tblSize)
        table.cell(stat_tbl, 1, row, disp_all_touched ? "✓" : "✗", bgcolor=disp_all_touched ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
        table.cell(stat_tbl, 0, row, "H1 EMA Trend", text_size=tblSize)
        table.cell(stat_tbl, 1, row, ema_trend_15m_h1 > 0 ? "Bullish" : ema_trend_15m_h1 < 0 ? "Bearish" : "Neutral", bgcolor=ema_trend_15m_h1 > 0 ? color.green : ema_trend_15m_h1 < 0 ? color.red : color.gray, text_color=color.white, text_size=tblSize)
        row += 1
        string lock_str = i_directionLock == "Long Only" ? "▲ LONG" : i_directionLock == "Short Only" ? "▼ SHORT" : "◆ BOTH"
        color lock_col = i_directionLock == "Long Only" ? color.green : i_directionLock == "Short Only" ? color.red : color.gray
        table.cell(stat_tbl, 0, row, "Dir Lock", text_size=tblSize)
        table.cell(stat_tbl, 1, row, lock_str, bgcolor=lock_col, text_color=color.white, text_size=tblSize)
        row += 1
        if i_htfTrendMode != "Off"
            string htf_dir_str = htf_trend_bullish and htf_trend_bearish ? "OFF" : htf_trend_bullish ? "▲ BULL" : htf_trend_bearish ? "▼ BEAR" : "— FLAT"
            color htf_dir_col = htf_trend_bullish and htf_trend_bearish ? color.gray : htf_trend_bullish ? color.green : htf_trend_bearish ? color.red : color.new(color.yellow, 50)
            table.cell(stat_tbl, 0, row, "HTF " + i_htfTrendMode, text_size=tblSize)
            table.cell(stat_tbl, 1, row, htf_dir_str, bgcolor=htf_dir_col, text_color=color.white, text_size=tblSize)
            row += 1
        if i_showADR
            table.cell(stat_tbl, 0, row, "ADR(" + str.tostring(i_adrPeriod) + ")", text_size=tblSize)
            table.cell(stat_tbl, 1, row, not na(adr_value) ? str.tostring(adr_value, "#.#####") : "Calculating...", text_size=tblSize)
            row += 1
            table.cell(stat_tbl, 0, row, "ADR Used", text_size=tblSize)
            color adr_pct_col = not na(adr_pct_used) ? (adr_pct_used >= 100 ? color.red : adr_pct_used >= 75 ? color.orange : color.green) : color.gray
            table.cell(stat_tbl, 1, row, not na(adr_pct_used) ? str.tostring(adr_pct_used, "#.#") + "%" : "---", bgcolor=adr_pct_col, text_color=color.white, text_size=tblSize)
            row += 1
            table.cell(stat_tbl, 0, row, "ADR Status", text_size=tblSize)
            string adr_status = adr_upper_hit_today and adr_lower_hit_today ? "BOTH HIT" : adr_upper_hit_today ? "Upper Hit" : adr_lower_hit_today ? "Lower Hit" : "In Range"
            color adr_status_col = adr_upper_hit_today or adr_lower_hit_today ? color.orange : color.green
            table.cell(stat_tbl, 1, row, adr_status, bgcolor=adr_status_col, text_color=color.white, text_size=tblSize)
            row += 1
            if i_enableADRFilter
                bool adr_blocked = not adr_filter_ok
                string adr_filt_str = adr_blocked ? "BLOCKED (" + str.tostring(adr_pct_used, "#.#") + "% > " + str.tostring(i_adrFilterThreshold, "#") + "%)" : "OK"
                table.cell(stat_tbl, 0, row, "ADR Filter", text_size=tblSize)
                table.cell(stat_tbl, 1, row, adr_filt_str, bgcolor=adr_blocked ? color.red : color.green, text_color=color.white, text_size=tblSize)
                row += 1
        if i_enableBreakeven
            bool is_be = (strategy.position_size > 0 and be_active_long) or (strategy.position_size < 0 and be_active_short)
            string be_str = is_be ? "BE Active" : strategy.position_size != 0 ? "Pending TP1" : "No Position"
            table.cell(stat_tbl, 0, row, "Breakeven", text_size=tblSize)
            table.cell(stat_tbl, 1, row, be_str, bgcolor=is_be ? color.teal : color.gray, text_color=color.white, text_size=tblSize)
            row += 1
        if i_enableWeeklyDD
            bool wk_dd_blocked = not weekly_dd_ok
            string wk_dd_str = wk_dd_blocked ? "BLOCKED (" + str.tostring(current_weekly_dd, "#.#") + "% > " + str.tostring(i_maxWeeklyDD, "#") + "%)" : str.tostring(current_weekly_dd, "#.#") + "% / " + str.tostring(i_maxWeeklyDD, "#") + "%"
            table.cell(stat_tbl, 0, row, "Weekly DD", text_size=tblSize)
            table.cell(stat_tbl, 1, row, wk_dd_str, bgcolor=wk_dd_blocked ? color.red : color.green, text_color=color.white, text_size=tblSize)
            row += 1
        if i_enableConsecLossLimit
            bool consec_blocked = not consec_loss_ok
            string consec_str = str.tostring(consec_loss_count) + " / " + str.tostring(i_maxConsecLosses) + (consec_blocked ? " HALTED" : "")
            table.cell(stat_tbl, 0, row, "Consec Loss", text_size=tblSize)
            table.cell(stat_tbl, 1, row, consec_str, bgcolor=consec_blocked ? color.red : color.green, text_color=color.white, text_size=tblSize)
            row += 1
        int conf_buy_30m = confluence_day3_buy_30m
        int conf_sell_30m = confluence_day3_sell_30m
        int conf_buy_15m = confluence_day3_buy_15m
        int conf_sell_15m = confluence_day3_sell_15m
        int conf_30m_dir = is_buy_direction ? conf_buy_30m : conf_sell_30m
        int conf_15m_dir = is_buy_direction ? conf_buy_15m : conf_sell_15m
        int current_conf_score = show_30m ? conf_30m_dir : conf_15m_dir
        int req_conf = is_buy_direction ? required_confluence_buy : required_confluence_sell
        bool conf_met = current_conf_score >= req_conf
        table.cell(stat_tbl, 0, row, "Confluence", text_size=tblSize)
        string boost_str = i_confluenceBoost > 0 ? " (+" + str.tostring(i_confluenceBoost) + ")" : ""
        table.cell(stat_tbl, 1, row, str.tostring(current_conf_score) + " / " + str.tostring(req_conf) + " req" + boost_str, bgcolor=conf_met ? color.green : color.red, text_color=color.white, text_size=tblSize)
        row += 1
    stat_tbl
// SECTION 12A: TABLES (Confluence & Status)
var table g_conf_tbl = na
var table g_stat_tbl = na
bool show_conf = i_tableMode == "Full" or i_tableMode == "Confluence Only" or i_tableMode == "Compact"
bool show_status = i_tableMode == "Full" or i_tableMode == "Status Only" or i_tableMode == "Compact"
if show_conf and barstate.islast
    g_conf_tbl := f_draw_confluence_table(g_conf_tbl)
if show_status and barstate.islast
    g_stat_tbl := f_draw_status_table(g_stat_tbl)
// SECTION 13: ALERTS (OPTIMIZED)
string GRP_ALT = "▸ Alert Settings"
bool i_enableSignalAlerts = input.bool(true, "Enable Signal Alerts", group=GRP_ALT)
bool i_alertDay2Signals   = input.bool(true, "  └─ Day 2 Alerts", group=GRP_ALT)
bool i_alertDay3Signals   = input.bool(true, "  └─ Day 3 Alerts", group=GRP_ALT)
bool i_alertPureSignals   = input.bool(true, "  └─ Pure MAD Alerts", group=GRP_ALT)
bool i_enableExitAlerts   = input.bool(true, "Enable Exit Alerts", group=GRP_ALT)
string GRP_DAY_ALT = "▸ Day Classification Alerts"
bool i_enableDayAlerts    = input.bool(false, "Enable Day Classification Alerts", group=GRP_DAY_ALT)
string GRP_BL = "▸ Baseline Touch Alerts"
string i_blAlertMode = input.string("Exact Touch", "Alert Sensitivity", options=["Exact Touch", "1 pip", "3 pips", "5 pips", "Custom", "Zone (Entry)"], group=GRP_BL)
float i_blAlertCustomPips = input.float(1.0, "  └─ Custom Pips", minval=0.0, maxval=50.0, step=0.5, group=GRP_BL)
bool i_alertHTFBaseline   = input.bool(true, "Enable HTF Baseline Alerts", group=GRP_BL)
bool i_alert1hrBaseline   = input.bool(true, "  └─ 1hr Baseline", group=GRP_BL)
bool i_alert2hrBaseline   = input.bool(true, "  └─ 2hr Baseline", group=GRP_BL)
bool i_alertLTFBaseline   = input.bool(true, "Enable LTF Baseline Alerts", group=GRP_BL)
bool i_alert15mBaseline   = input.bool(true, "  └─ 15m Baseline", group=GRP_BL)
bool i_alert30mBaseline   = input.bool(true, "  └─ 30m Baseline", group=GRP_BL)
f_dayCtx() =>
    switch prefix5
        PREFIX_GSD => "GSD D" + str.tostring(gsd5 + 1)
        PREFIX_RSD => "RSD D" + str.tostring(rsd5 + 1)
        PREFIX_GD  => "GD D" + str.tostring(gsd5 + 1)
        PREFIX_RD  => "RD D" + str.tostring(rsd5 + 1)
        => "---"
f_grade(bool isA) => isA ? "A" : "B"
f_price() => str.tostring(close, "#.#####")
string SYM = syminfo.ticker
string CTX = f_dayCtx()
float blAlertTol = switch i_blAlertMode
    "Exact Touch" => 0.0
    "1 pip" => syminfo.mintick * 10
    "3 pips" => syminfo.mintick * 30
    "5 pips" => syminfo.mintick * 50
    "Custom" => i_blAlertCustomPips * syminfo.mintick * 10
    => baseline_tolerance
f_blTouch(float emaVal, float hiVal, float loVal, float clVal, bool wasInZone) =>
    bool bullTouch = not na(emaVal) and loVal <= (emaVal + blAlertTol) and clVal > emaVal
    bool bearTouch = not na(emaVal) and hiVal >= (emaVal - blAlertTol) and clVal < emaVal
    bool inZone = bullTouch or bearTouch
    bool fresh = inZone and not wasInZone
    [inZone, fresh, bullTouch and fresh, bearTouch and fresh]
var bool was1hr = false, var bool alerted1hr = false
[in1hr, fresh1hr, bull1hr, bear1hr] = f_blTouch(htf_1hr_ema50, htf_1hr_h, htf_1hr_l, htf_1hr_c, was1hr)
if was1hr and not in1hr
    alerted1hr := false
was1hr := in1hr
var bool was2hr = false, var bool alerted2hr = false
[in2hr, fresh2hr, bull2hr, bear2hr] = f_blTouch(htf_2hr_ema50, htf_2hr_h, htf_2hr_l, htf_2hr_c, was2hr)
if was2hr and not in2hr
    alerted2hr := false
was2hr := in2hr
var bool was15m = false, var bool alerted15m = false
[in15m, fresh15m_raw, bull15m, bear15m] = f_blTouch(eff_15m_ema50, eff_15m_h, eff_15m_l, eff_15m_c, was15m)
bool fresh15m = fresh15m_raw and new_15m_bar
if was15m and not in15m
    alerted15m := false
was15m := in15m
var bool was30m = false, var bool alerted30m = false
[in30m, fresh30m_raw, bull30m, bear30m] = f_blTouch(eff_30m_ema50, eff_30m_h, eff_30m_l, eff_30m_c, was30m)
bool fresh30m = fresh30m_raw and new_30m_bar
if was30m and not in30m
    alerted30m := false
was30m := in30m
f_sigAlert(bool cond, string prefix) =>
    if cond
        alert(prefix + " " + SYM + " @ " + f_price() + " | " + CTX, alert.freq_once_per_bar)
if i_enableSignalAlerts
    if i_alertDay2Signals
        f_sigAlert(final_day2_buy_15m, "🟢 " + (fbr_origin_cycle ? "FBR-" : "") + "D2 BUY 15m [" + f_grade(is_a_setup_buy_15m) + "]")
        f_sigAlert(final_day2_sell_15m, "🔴 " + (fbr_origin_cycle ? "FBR-" : "") + "D2 SELL 15m [" + f_grade(is_a_setup_sell_15m) + "]")
        f_sigAlert(final_day2_buy_30m, "🟢 " + (fbr_origin_cycle ? "FBR-" : "") + "D2 BUY 30m [" + f_grade(is_a_setup_buy_30m) + "]")
        f_sigAlert(final_day2_sell_30m, "🔴 " + (fbr_origin_cycle ? "FBR-" : "") + "D2 SELL 30m [" + f_grade(is_a_setup_sell_30m) + "]")
    if i_alertDay3Signals
        f_sigAlert(final_day3_buy_15m, "🟢 " + (fbr_origin_cycle ? "FBR-" : "") + "D3 BUY 15m [" + f_grade(is_a_setup_buy_15m) + "]")
        f_sigAlert(final_day3_sell_15m, "🔴 " + (fbr_origin_cycle ? "FBR-" : "") + "D3 SELL 15m [" + f_grade(is_a_setup_sell_15m) + "]")
        f_sigAlert(final_day3_buy_30m, "🟢 " + (fbr_origin_cycle ? "FBR-" : "") + "D3 BUY 30m [" + f_grade(is_a_setup_buy_30m) + "]")
        f_sigAlert(final_day3_sell_30m, "🔴 " + (fbr_origin_cycle ? "FBR-" : "") + "D3 SELL 30m [" + f_grade(is_a_setup_sell_30m) + "]")
    if i_alertPureSignals
        f_sigAlert(final_pure_buy_15m, "🟢 MAD BUY 15m [" + f_grade(is_a_setup_buy_15m) + "]")
        f_sigAlert(final_pure_sell_15m, "🔴 MAD SELL 15m [" + f_grade(is_a_setup_sell_15m) + "]")
        f_sigAlert(final_pure_buy_30m, "🟢 MAD BUY 30m [" + f_grade(is_a_setup_buy_30m) + "]")
        f_sigAlert(final_pure_sell_30m, "🔴 MAD SELL 30m [" + f_grade(is_a_setup_sell_30m) + "]")
f_blAlert(bool enabled, bool fresh, bool alerted, bool bull, bool bear, string tf) =>
    if enabled and fresh and not alerted
        string dir = bull ? "BULL" : bear ? "BEAR" : "NEUT"
        string emo = bull ? "🟢" : bear ? "🔴" : "⚪"
        alert(emo + " " + tf + " BL TOUCH (" + dir + ") " + SYM + " @ " + f_price() + " | " + CTX, alert.freq_once_per_bar)
        true
    else
        alerted
if i_alertHTFBaseline
    alerted1hr := f_blAlert(i_alert1hrBaseline, fresh1hr, alerted1hr, bull1hr, bear1hr, "1HR")
    alerted2hr := f_blAlert(i_alert2hrBaseline, fresh2hr, alerted2hr, bull2hr, bear2hr, "2HR")
if i_alertLTFBaseline
    alerted15m := f_blAlert(i_alert15mBaseline, fresh15m, alerted15m, bull15m, bear15m, "15M")
    alerted30m := f_blAlert(i_alert30mBaseline, fresh30m, alerted30m, bull30m, bear30m, "30M")
if i_enableDayAlerts and rollover5
    int _prevDayLabel = nz(dayLabelType5[1], DLABEL_NORMAL)
    bool dayLabelChanged = dayLabelType5 != _prevDayLabel
    if dayLabelChanged
        string dayCtx = CTX
        switch dayLabelType5
            DLABEL_FBR_BULL =>
                alert("🟠 FBR BULL on " + SYM + " → GSD D1 | LONG | " + dayCtx, alert.freq_once_per_bar)
            DLABEL_FBR_BEAR =>
                alert("🟠 FBR BEAR on " + SYM + " → RSD D1 | SHORT | " + dayCtx, alert.freq_once_per_bar)
            DLABEL_CLEAN_BULL =>
                alert("🟢 CLEAN BULL BO on " + SYM + " | PWH cleared | " + dayCtx, alert.freq_once_per_bar)
            DLABEL_CLEAN_BEAR =>
                alert("🔴 CLEAN BEAR BO on " + SYM + " | PWL cleared | " + dayCtx, alert.freq_once_per_bar)
            DLABEL_INSIDE =>
                alert("⬜ INSIDE DAY on " + SYM + " | Frozen | " + dayCtx, alert.freq_once_per_bar)
            =>
                if gsd5 == 1
                    alert("🟢 GSD D1 on " + SYM + " | D2 tomorrow | " + dayCtx, alert.freq_once_per_bar)
                if rsd5 == 1
                    alert("🔴 RSD D1 on " + SYM + " | D2 tomorrow | " + dayCtx, alert.freq_once_per_bar)
if i_enableExitAlerts
    if strategy.position_size > 0 and exit_buy
        string ext = exit_stop_long ? "M1-R3 SL" : m1_exit_rule1_long ? "M1-R1" : exit_tp1_long ? "TP1" : m1_exit_rule2_long ? "M1-R2" : exit_tp2_long ? "TP2" : exit_tp3_long ? "TP3" : "EXIT"
        alert("⚪ EXIT LONG: " + ext + " " + SYM + " @ " + f_price(), alert.freq_once_per_bar)
    if strategy.position_size < 0 and exit_sell
        string ext = exit_stop_short ? "M1-R3 SL" : m1_exit_rule1_short ? "M1-R1" : exit_tp1_short ? "TP1" : m1_exit_rule2_short ? "M1-R2" : exit_tp2_short ? "TP2" : exit_tp3_short ? "TP3" : "EXIT"
        alert("⚪ EXIT SHORT: " + ext + " " + SYM + " @ " + f_price(), alert.freq_once_per_bar)
    if i_enableDDBreaker and not dd_breaker_ok and dd_breaker_ok[1]
        alert("⛔ DD: " + SYM + " " + str.tostring(current_daily_dd, "#.#") + "% > " + str.tostring(i_maxDailyDD, "#.#") + "% halted", alert.freq_once_per_bar)
    if i_enableThreeStrike and not strike_limit_ok and strike_limit_ok[1]
        alert("⛔ STRIKES: " + SYM + " " + str.tostring(daily_loss_count) + " losses halted", alert.freq_once_per_bar)
    if i_enableTradeFreqLimit and not trade_freq_ok and trade_freq_ok[1]
        alert("⛔ FREQ: " + SYM + " " + str.tostring(daily_trade_count) + "d/" + str.tostring(weekly_trade_count) + "w halted", alert.freq_once_per_bar)
    if i_enableWeeklyDD and not weekly_dd_ok and weekly_dd_ok[1]
        alert("⛔ WK DD: " + SYM + " " + str.tostring(current_weekly_dd, "#.#") + "% > " + str.tostring(i_maxWeeklyDD, "#.#") + "% halted", alert.freq_once_per_bar)
    if i_enableConsecLossLimit and not consec_loss_ok and consec_loss_ok[1]
        alert("⛔ CONSEC: " + SYM + " " + str.tostring(consec_loss_count) + " losses halted", alert.freq_once_per_bar)
plotshape(i_alertHTFBaseline and i_alert1hrBaseline and fresh1hr and bull1hr, "1h BL Bull", shape.circle, location.belowbar, color.new(color.green, 40), size=size.tiny)
plotshape(i_alertHTFBaseline and i_alert1hrBaseline and fresh1hr and bear1hr, "1h BL Bear", shape.circle, location.abovebar, color.new(color.red, 40), size=size.tiny)
plotshape(i_alertHTFBaseline and i_alert2hrBaseline and fresh2hr and bull2hr, "2h BL Bull", shape.circle, location.belowbar, color.new(color.green, 30), size=size.tiny)
plotshape(i_alertHTFBaseline and i_alert2hrBaseline and fresh2hr and bear2hr, "2h BL Bear", shape.circle, location.abovebar, color.new(color.red, 30), size=size.tiny)