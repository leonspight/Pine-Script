f_baseline_touch_buy(_open, _low, _close, _ema50) =>
    bool is_bullish_candle = _close > _open
    bool price_touched = _low <= (_ema50 + baseline_tolerance)
    bool closed_above = _close > _ema50
    is_bullish_candle and price_touched and closed_above
f_baseline_touch_sell(_open, _high, _close, _ema50) =>
    bool is_bearish_candle = _close < _open
    bool price_touched = _high >= (_ema50 - baseline_tolerance)
    bool closed_below = _close < _ema50
    is_bearish_candle and price_touched and closed_below
