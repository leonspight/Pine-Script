f_is_bullish(_open, _close) => _close > _open
f_is_bearish(_open, _close) => _close < _open
f_get_cascade_data() => [open, high, low, close, open[1], high[1], low[1], close[1]]
[h4_o, h4_h, h4_l, h4_c, h4_o1, h4_h1, h4_l1, h4_c1] = request.security(syminfo.tickerid, "240", f_get_cascade_data(), lookahead=barmerge.lookahead_off)
[h1_o, h1_h, h1_l, h1_c, h1_o1, h1_h1, h1_l1, h1_c1] = request.security(syminfo.tickerid, "60", f_get_cascade_data(), lookahead=barmerge.lookahead_off)
[m30_o, m30_h, m30_l, m30_c, m30_o1, m30_h1, m30_l1, m30_c1] = request.security(syminfo.tickerid, "30", f_get_cascade_data(), lookahead=barmerge.lookahead_off)
[m15_o, m15_h, m15_l, m15_c, m15_o1, m15_h1, m15_l1, m15_c1] = request.security(syminfo.tickerid, "15", f_get_cascade_data(), lookahead=barmerge.lookahead_off)
bool new_h4_bar = ta.change(time("240")) != 0
bool new_h1_bar = ta.change(time("60")) != 0
bool new_30m_bar_exh = ta.change(time("30")) != 0
bool new_15m_bar_exh = ta.change(time("15")) != 0
f_detect_absorption(_curr_o, _curr_h, _curr_l, _curr_c, _prev_o, _prev_h, _prev_l, _prev_c) =>
    bool prev_bull = f_is_bullish(_prev_o, _prev_c)
    bool prev_bear = f_is_bearish(_prev_o, _prev_c)
    bool curr_bull = f_is_bullish(_curr_o, _curr_c)
    bool curr_bear = f_is_bearish(_curr_o, _curr_c)
    bool bull_abs = prev_bear and curr_bull
    bool bear_abs = prev_bull and curr_bear
    float zone_top = math.max(_prev_h, _curr_h)
    float zone_bottom = math.min(_prev_l, _curr_l)
    [bull_abs, bear_abs, zone_top, zone_bottom]
[h4_bull_abs, h4_bear_abs, h4_zone_top, h4_zone_bot] = f_detect_absorption(h4_o, h4_h, h4_l, h4_c, h4_o1, h4_h1, h4_l1, h4_c1)
[h1_bull_abs, h1_bear_abs, h1_zone_top, h1_zone_bot] = f_detect_absorption(h1_o, h1_h, h1_l, h1_c, h1_o1, h1_h1, h1_l1, h1_c1)
[m30_bull_abs, m30_bear_abs, m30_zone_top, m30_zone_bot] = f_detect_absorption(m30_o, m30_h, m30_l, m30_c, m30_o1, m30_h1, m30_l1, m30_c1)
[m15_bull_abs, m15_bear_abs, m15_zone_top, m15_zone_bot] = f_detect_absorption(m15_o, m15_h, m15_l, m15_c, m15_o1, m15_h1, m15_l1, m15_c1)
if rollover5 and i_terminateAtRollover
    active_h4_top := na
    active_h4_bot := na
    active_h1_top := na
    active_h1_bot := na
    active_30m_top := na
    active_30m_bot := na
    active_15m_top := na
    active_15m_bot := na
f_within_parent(_child_top, _child_bot, _parent_top, _parent_bot) =>
    not na(_parent_top) and not na(_parent_bot) and _child_bot >= _parent_bot and _child_top <= _parent_top
if i_showExhaustionAreas and i_showCandleExhaustion and new_h4_bar
    if h4_bull_abs
        active_h4_top := h4_zone_top
        active_h4_bot := h4_zone_bot
        active_h4_is_bull := true
        active_h4_start := time
        active_h1_top := na
        active_30m_top := na
        active_15m_top := na
    else if h4_bear_abs
        active_h4_top := h4_zone_top
        active_h4_bot := h4_zone_bot
        active_h4_is_bull := false
        active_h4_start := time
        active_h1_top := na
        active_30m_top := na
        active_15m_top := na
if i_showExhaustionAreas and i_showCandleExhaustion and i_enableCascadeRefinement and new_h1_bar
    bool h1_within_h4 = f_within_parent(h1_zone_top, h1_zone_bot, active_h4_top, active_h4_bot)
    bool h1_same_dir = (h1_bull_abs and active_h4_is_bull) or (h1_bear_abs and not active_h4_is_bull)
    if h1_within_h4 and (h1_bull_abs or h1_bear_abs) and h1_same_dir
        active_h1_top := h1_zone_top
        active_h1_bot := h1_zone_bot
        active_h1_is_bull := h1_bull_abs
        active_h1_start := time
        active_30m_top := na
        active_15m_top := na
if i_showExhaustionAreas and i_showCandleExhaustion and i_enableCascadeRefinement and new_30m_bar_exh
    float parent_top = not na(active_h1_top) ? active_h1_top : active_h4_top
    float parent_bot = not na(active_h1_bot) ? active_h1_bot : active_h4_bot
    bool parent_is_bull = not na(active_h1_top) ? active_h1_is_bull : active_h4_is_bull
    bool m30_within = f_within_parent(m30_zone_top, m30_zone_bot, parent_top, parent_bot)
    bool m30_same_dir = (m30_bull_abs and parent_is_bull) or (m30_bear_abs and not parent_is_bull)
    if m30_within and (m30_bull_abs or m30_bear_abs) and m30_same_dir
        active_30m_top := m30_zone_top
        active_30m_bot := m30_zone_bot
        active_30m_is_bull := m30_bull_abs
        active_30m_start := time
        active_15m_top := na
if i_showExhaustionAreas and i_showCandleExhaustion and i_enableCascadeRefinement and new_15m_bar_exh
    float parent_top = not na(active_30m_top) ? active_30m_top : not na(active_h1_top) ? active_h1_top : active_h4_top
    float parent_bot = not na(active_30m_bot) ? active_30m_bot : not na(active_h1_bot) ? active_h1_bot : active_h4_bot
    bool parent_is_bull = not na(active_30m_top) ? active_30m_is_bull : not na(active_h1_top) ? active_h1_is_bull : active_h4_is_bull
    bool m15_within = f_within_parent(m15_zone_top, m15_zone_bot, parent_top, parent_bot)
    bool m15_same_dir = (m15_bull_abs and parent_is_bull) or (m15_bear_abs and not parent_is_bull)
    if m15_within and (m15_bull_abs or m15_bear_abs) and m15_same_dir
        active_15m_top := m15_zone_top
        active_15m_bot := m15_zone_bot
        active_15m_is_bull := m15_bull_abs
        active_15m_start := time
f_get_target_display_tf() =>
    int result = TF_H4
    if i_exhaustionDisplayTF == "Auto (Match Signal TF)"
        float tf_mins = timeframe.isminutes ? timeframe.multiplier : timeframe.isdaily ? 1440.0 : 60.0
        result := tf_mins <= 15 ? TF_15M : tf_mins <= 30 ? TF_30M : tf_mins <= 60 ? TF_H1 : TF_H4
    else if i_exhaustionDisplayTF == "15m Only"
        result := TF_15M
    else if i_exhaustionDisplayTF == "30m Only"
        result := TF_30M
    else if i_exhaustionDisplayTF == "H1 Only"
        result := TF_H1
    else if i_exhaustionDisplayTF == "H4 Only"
        result := TF_H4
    else
        result := 0
    result
int target_display_tf = f_get_target_display_tf()
f_get_best_zone(_target_tf) =>
    float best_top = na
    float best_bot = na
    bool best_bull = false
    int best_start = na
    int best_level = 0
    if _target_tf <= TF_15M and not na(active_15m_top)
        best_top := active_15m_top
        best_bot := active_15m_bot
        best_bull := active_15m_is_bull
        best_start := active_15m_start
        best_level := TF_15M
    else if _target_tf <= TF_30M and not na(active_30m_top)
        best_top := active_30m_top
        best_bot := active_30m_bot
        best_bull := active_30m_is_bull
        best_start := active_30m_start
        best_level := TF_30M
    else if _target_tf <= TF_H1 and not na(active_h1_top)
        best_top := active_h1_top
        best_bot := active_h1_bot
        best_bull := active_h1_is_bull
        best_start := active_h1_start
        best_level := TF_H1
    else if not na(active_h4_top)
        best_top := active_h4_top
        best_bot := active_h4_bot
        best_bull := active_h4_is_bull
        best_start := active_h4_start
        best_level := TF_H4
    [best_top, best_bot, best_bull, best_start, best_level]
[display_top, display_bot, display_is_bull, display_start, display_level] = f_get_best_zone(target_display_tf)
f_next_rollover_time() =>
    int curr_h = hour(time, i_rolloverTimezone)
    int hours_to_rollover = curr_h >= i_rolloverHour ? (24 - curr_h + i_rolloverHour) : (i_rolloverHour - curr_h)
    time + (hours_to_rollover * 60 * 60 * 1000)
int rollover_end = f_next_rollover_time()
f_get_exhaustion_border_color(_is_bull, _fill_color) =>
    color result = na
    if i_useCustomBorderColor
        result := _is_bull ? i_exhaustionBullBorder : i_exhaustionBearBorder
    else
        result := color.new(_fill_color, i_exhaustionBorderOpacity)
    result
var box primary_exh_box = na
var box h4_context_box = na
var box h1_context_box = na
var float _prev_display_top = na
var float _prev_display_bot = na
var int _prev_display_start = na
var bool _prev_display_bull = false
var int _prev_display_level = 0
var float _prev_h4_top = na
var float _prev_h1_top = na
bool _cascade_changed = display_top != _prev_display_top or display_bot != _prev_display_bot or
     nz(display_start) != nz(_prev_display_start) or display_is_bull != _prev_display_bull or
     display_level != _prev_display_level or active_h4_top != _prev_h4_top or active_h1_top != _prev_h1_top
_prev_display_top := display_top
_prev_display_bot := display_bot
_prev_display_start := display_start
_prev_display_bull := display_is_bull
_prev_display_level := display_level
_prev_h4_top := active_h4_top
_prev_h1_top := active_h1_top
if i_showExhaustionAreas
    if _cascade_changed
        box.delete(primary_exh_box)
        box.delete(h4_context_box)
        box.delete(h1_context_box)
        if not na(display_top) and not na(display_bot) and not na(display_start)
            color box_col = display_is_bull ? i_exhaustionBullColor : i_exhaustionBearColor
            color border_col = f_get_exhaustion_border_color(display_is_bull, box_col)
            string tf_str = display_level == TF_15M ? "15m" : display_level == TF_30M ? "30m" : display_level == TF_H1 ? "H1" : "H4"
            string dir_str = display_is_bull ? " Support" : " Resistance"
            primary_exh_box := box.new(
                 display_start, display_top, rollover_end, display_bot,
                 xloc=xloc.bar_time,
                 bgcolor=box_col,
                 border_color=border_col,
                 border_width=i_exhaustionBorderWidth,
                 text=tf_str + dir_str,
                 text_color=color.white,
                 text_size=size.small,
                 text_halign=text.align_left,
                 text_valign=text.align_top)
        if i_showHTFContext and target_display_tf != 0
            if display_level < TF_H4 and not na(active_h4_top)
                color h4_fill = color.new(active_h4_is_bull ? color.green : color.red, i_htfContextOpacity)
                color h4_border = f_get_exhaustion_border_color(active_h4_is_bull, h4_fill)
                h4_context_box := box.new(
                     nz(active_h4_start, time), active_h4_top, rollover_end, active_h4_bot,
                     xloc=xloc.bar_time,
                     bgcolor=h4_fill,
                     border_color=color.new(h4_border, i_htfContextOpacity - 20),
                     border_width=1,
                     border_style=line.style_dashed,
                     text="H4 Context",
                     text_color=color.new(color.white, 50),
                     text_size=size.tiny)
            if display_level < TF_H1 and not na(active_h1_top)
                color h1_fill = color.new(active_h1_is_bull ? color.green : color.red, i_htfContextOpacity - 10)
                color h1_border = f_get_exhaustion_border_color(active_h1_is_bull, h1_fill)
                h1_context_box := box.new(
                     nz(active_h1_start, time), active_h1_top, rollover_end, active_h1_bot,
                     xloc=xloc.bar_time,
                     bgcolor=h1_fill,
                     border_color=color.new(h1_border, i_htfContextOpacity - 30),
                     border_width=1,
                     border_style=line.style_dotted,
                     text="H1 Context",
                     text_color=color.new(color.white, 50),
                     text_size=size.tiny)
    else
        if not na(primary_exh_box)
            box.set_right(primary_exh_box, rollover_end)
        if not na(h4_context_box)
            box.set_right(h4_context_box, rollover_end)
        if not na(h1_context_box)
            box.set_right(h1_context_box, rollover_end)
var box asia_high_box = na
var box asia_low_box = na
var box london_high_box = na
var box london_low_box = na
var box ny_high_box = na
var box ny_low_box = na
if rollover5 and i_terminateAtRollover
    box.delete(asia_high_box)
    box.delete(asia_low_box)
    box.delete(london_high_box)
    box.delete(london_low_box)
    box.delete(ny_high_box)
    box.delete(ny_low_box)
    asia_high_box := na
    asia_low_box := na
    london_high_box := na
    london_low_box := na
    ny_high_box := na
    ny_low_box := na
    asia_session_high := na
    asia_session_low := na
    asia_high_time := na
    asia_low_time := na
    london_session_high := na
    london_session_low := na
    london_high_time := na
    london_low_time := na
    ny_session_high := na
    ny_session_low := na
    ny_high_time := na
    ny_low_time := na
f_session_zone_height(_high, _low) =>
    float _range = _high - _low
    _range > 0 ? _range * 0.1 : syminfo.mintick * 100
if i_showExhaustionAreas and i_showSessionExhaustion
    bool asia_just_closed = in_asian[1] and not in_asian
    if i_showAsiaExhaustion and asia_just_closed and not na(asia_session_high) and not na(asia_session_low)
        float asia_zone_h = f_session_zone_height(asia_session_high, asia_session_low)
        color asia_res_fill = i_exhaustionBearColor
        color asia_res_border = f_get_exhaustion_border_color(false, asia_res_fill)
        asia_high_box := box.new(
             asia_high_time, asia_session_high,
             rollover_end, asia_session_high - asia_zone_h,
             xloc=xloc.bar_time,
             bgcolor=asia_res_fill,
             border_color=asia_res_border,
             border_width=i_exhaustionBorderWidth,
             text="Asia H", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_top)
        color asia_sup_fill = i_exhaustionBullColor
        color asia_sup_border = f_get_exhaustion_border_color(true, asia_sup_fill)
        asia_low_box := box.new(
             asia_low_time, asia_session_low + asia_zone_h,
             rollover_end, asia_session_low,
             xloc=xloc.bar_time,
             bgcolor=asia_sup_fill,
             border_color=asia_sup_border,
             border_width=i_exhaustionBorderWidth,
             text="Asia L", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_bottom)
    bool london_just_closed = in_london[1] and not in_london
    if i_showLondonExhaustion and london_just_closed and not na(london_session_high) and not na(london_session_low)
        float lon_zone_h = f_session_zone_height(london_session_high, london_session_low)
        color lon_res_fill = i_exhaustionBearColor
        color lon_res_border = f_get_exhaustion_border_color(false, lon_res_fill)
        london_high_box := box.new(
             london_high_time, london_session_high,
             rollover_end, london_session_high - lon_zone_h,
             xloc=xloc.bar_time,
             bgcolor=lon_res_fill,
             border_color=lon_res_border,
             border_width=i_exhaustionBorderWidth,
             text="London H", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_top)
        color lon_sup_fill = i_exhaustionBullColor
        color lon_sup_border = f_get_exhaustion_border_color(true, lon_sup_fill)
        london_low_box := box.new(
             london_low_time, london_session_low + lon_zone_h,
             rollover_end, london_session_low,
             xloc=xloc.bar_time,
             bgcolor=lon_sup_fill,
             border_color=lon_sup_border,
             border_width=i_exhaustionBorderWidth,
             text="London L", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_bottom)
    bool ny_just_closed = in_ny[1] and not in_ny
    if i_showNYExhaustion and ny_just_closed and not na(ny_session_high) and not na(ny_session_low)
        float ny_zone_h = f_session_zone_height(ny_session_high, ny_session_low)
        color ny_res_fill = i_exhaustionBearColor
        color ny_res_border = f_get_exhaustion_border_color(false, ny_res_fill)
        ny_high_box := box.new(
             ny_high_time, ny_session_high,
             rollover_end, ny_session_high - ny_zone_h,
             xloc=xloc.bar_time,
             bgcolor=ny_res_fill,
             border_color=ny_res_border,
             border_width=i_exhaustionBorderWidth,
             text="NY H", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_top)
        color ny_sup_fill = i_exhaustionBullColor
        color ny_sup_border = f_get_exhaustion_border_color(true, ny_sup_fill)
        ny_low_box := box.new(
             ny_low_time, ny_session_low + ny_zone_h,
             rollover_end, ny_session_low,
             xloc=xloc.bar_time,
             bgcolor=ny_sup_fill,
             border_color=ny_sup_border,
             border_width=i_exhaustionBorderWidth,
             text="NY L", text_color=color.white, text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_bottom)
float active_exhaustion_top = display_top
float active_exhaustion_bottom = display_bot
bool active_exhaustion_is_bullish = display_is_bull
bool price_in_exhaustion = not na(active_exhaustion_top) and not na(active_exhaustion_bottom) and
     high >= active_exhaustion_bottom and low <= active_exhaustion_top
bool exhaustion_rejection_bull = price_in_exhaustion and active_exhaustion_is_bullish and close > active_exhaustion_top
bool exhaustion_rejection_bear = price_in_exhaustion and not active_exhaustion_is_bullish and close < active_exhaustion_bottom
bool exhaustion_break_above = not na(active_exhaustion_top) and close > active_exhaustion_top and close[1] <= active_exhaustion_top
bool exhaustion_break_below = not na(active_exhaustion_bottom) and close < active_exhaustion_bottom and close[1] >= active_exhaustion_bottom
var bool broke_exhaustion_above = false
var bool broke_exhaustion_below = false
if exhaustion_break_above
    broke_exhaustion_above := true
if exhaustion_break_below
    broke_exhaustion_below := true
bool came_back_after_break_above = broke_exhaustion_above and close < active_exhaustion_top
bool came_back_after_break_below = broke_exhaustion_below and close > active_exhaustion_bottom
if rollover5 or (new_h4_bar and (h4_bull_abs or h4_bear_abs))
    broke_exhaustion_above := false
    broke_exhaustion_below := false
bool m1_exit_rule1_long  = i_enableM1R1Exit and strategy.position_size > 0 and not tp1_hit_long and exhaustion_rejection_bear
bool m1_exit_rule1_short = i_enableM1R1Exit and strategy.position_size < 0 and not tp1_hit_short and exhaustion_rejection_bull
bool m1_exit_rule2_long  = strategy.position_size > 0 and tp1_hit_long and not m1r2_hit_long and came_back_after_break_above
bool m1_exit_rule2_short = strategy.position_size < 0 and tp1_hit_short and not m1r2_hit_short and came_back_after_break_below
bool exit_buy  = exit_stop_long or exit_tp1_long or m1_exit_rule1_long or m1_exit_rule2_long or exit_tp2_long or exit_tp3_long
bool exit_sell = exit_stop_short or exit_tp1_short or m1_exit_rule1_short or m1_exit_rule2_short or exit_tp2_short or exit_tp3_short
// SECTION 10: STRATEGY EXECUTION
f_position_size(_entry, _sl, _risk_pct) =>
    float risk_amount = strategy.equity * (_risk_pct / 100)
    float _pip_value = (str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")) ? syminfo.mintick : syminfo.mintick * 10
    float spread_price = i_spreadPips * _pip_value
    float sl_distance = math.abs(_entry - _sl) + spread_price
    sl_distance > 0 ? risk_amount / sl_distance : 0
f_close_all_longs(_comment) =>
    for i = 0 to array.size(LONG_IDS) - 1
        strategy.close(array.get(LONG_IDS, i), comment=_comment)
f_close_all_shorts(_comment) =>
    for i = 0 to array.size(SHORT_IDS) - 1
        strategy.close(array.get(SHORT_IDS, i), comment=_comment)
var float daily_starting_equity = strategy.initial_capital
var int   daily_trade_count     = 0
var int   weekly_trade_count    = 0
var int   daily_loss_count      = 0
var int   prev_num_closed       = 0
var int   prev_num_open         = 0
var float weekly_starting_equity = strategy.initial_capital
var int   consec_loss_count      = 0
if rollover5
    daily_starting_equity := strategy.equity
    daily_trade_count     := 0
    daily_loss_count      := 0
if is_new_week
    weekly_trade_count := 0
    weekly_starting_equity := strategy.equity
int current_num_closed = strategy.closedtrades
if current_num_closed > prev_num_closed
    for t = prev_num_closed to current_num_closed - 1
        if strategy.closedtrades.profit(t) < 0
            daily_loss_count += 1
            consec_loss_count += 1
        else if strategy.closedtrades.profit(t) > 0
            consec_loss_count := 0
prev_num_closed := current_num_closed
int current_num_open = strategy.opentrades
if current_num_open > prev_num_open
    int new_entries = current_num_open - prev_num_open
    daily_trade_count  += new_entries
    weekly_trade_count += new_entries
prev_num_open := current_num_open
float current_daily_dd = daily_starting_equity > 0 ?
     (daily_starting_equity - strategy.equity) / daily_starting_equity * 100 : 0.0
bool dd_breaker_ok = not i_enableDDBreaker or (current_daily_dd < i_maxDailyDD)
bool strike_limit_ok = not i_enableThreeStrike or (daily_loss_count < i_maxDailyLosses)
bool trade_freq_ok = not i_enableTradeFreqLimit or
     (daily_trade_count < i_maxDailyTrades and weekly_trade_count < i_maxWeeklyTrades)
float current_weekly_dd = weekly_starting_equity > 0 ?
     (weekly_starting_equity - strategy.equity) / weekly_starting_equity * 100 : 0.0
bool weekly_dd_ok = not i_enableWeeklyDD or (current_weekly_dd < i_maxWeeklyDD)
bool consec_loss_ok = not i_enableConsecLossLimit or (consec_loss_count < i_maxConsecLosses)
bool can_trade = strategy.position_size == 0 and barstate.isconfirmed and
     dd_breaker_ok and strike_limit_ok and trade_freq_ok and adr_filter_ok and
     weekly_dd_ok and consec_loss_ok
if exit_stop_long
    strategy.close_all(comment="M1-R3: EMA Reversal Full Exit")
    remaining_pct_long := 0.0
if exit_stop_short
    strategy.close_all(comment="M1-R3: EMA Reversal Full Exit")
    remaining_pct_short := 0.0
if not exit_stop_long and remaining_pct_long >= 100.0
    if exit_tp1_long or m1_exit_rule1_long
        float close_pct = math.min(i_tp1ClosePct / remaining_pct_long * 100.0, 100.0)
        string lbl = m1_exit_rule1_long ? "M1-R1: Exhaustion Reject " + str.tostring(i_tp1ClosePct, "#") + "%" : "TP1: Exhaustion Zone " + str.tostring(i_tp1ClosePct, "#") + "%"
        f_partial_close_longs(close_pct, lbl)
        tp1_hit_long := true
        remaining_pct_long := 100.0 - i_tp1ClosePct
if not exit_stop_short and remaining_pct_short >= 100.0
    if exit_tp1_short or m1_exit_rule1_short
        float close_pct = math.min(i_tp1ClosePct / remaining_pct_short * 100.0, 100.0)
        string lbl = m1_exit_rule1_short ? "M1-R1: Exhaustion Reject " + str.tostring(i_tp1ClosePct, "#") + "%" : "TP1: Exhaustion Zone " + str.tostring(i_tp1ClosePct, "#") + "%"
        f_partial_close_shorts(close_pct, lbl)
        tp1_hit_short := true
        remaining_pct_short := 100.0 - i_tp1ClosePct
if not exit_stop_long and tp1_hit_long and not m1r2_hit_long and m1_exit_rule2_long
    float target_close = remaining_pct_long * 0.5
    float close_pct = math.min(target_close / remaining_pct_long * 100.0, 100.0)
    f_partial_close_longs(close_pct, "M1-R2: Break & Return 50%")
    m1r2_hit_long := true
    remaining_pct_long := remaining_pct_long - target_close
if not exit_stop_short and tp1_hit_short and not m1r2_hit_short and m1_exit_rule2_short
    float target_close = remaining_pct_short * 0.5
    float close_pct = math.min(target_close / remaining_pct_short * 100.0, 100.0)
    f_partial_close_shorts(close_pct, "M1-R2: Break & Return 50%")
    m1r2_hit_short := true
    remaining_pct_short := remaining_pct_short - target_close
if not exit_stop_long and exit_tp2_long
    float target_remaining = 20.0
    if remaining_pct_long > target_remaining
        float to_close = remaining_pct_long - target_remaining
        float close_pct = math.min(to_close / remaining_pct_long * 100.0, 100.0)
        f_partial_close_longs(close_pct, "TP2: Second Zone")
        tp2_hit_long := true
        remaining_pct_long := target_remaining
if not exit_stop_short and exit_tp2_short
    float target_remaining = 20.0
    if remaining_pct_short > target_remaining
        float to_close = remaining_pct_short - target_remaining
        float close_pct = math.min(to_close / remaining_pct_short * 100.0, 100.0)
        f_partial_close_shorts(close_pct, "TP2: Second Zone")
        tp2_hit_short := true
        remaining_pct_short := target_remaining
if not exit_stop_long and exit_tp3_long
    f_close_all_longs("TP3: Swing Target")
    remaining_pct_long := 0.0
if not exit_stop_short and exit_tp3_short
    f_close_all_shorts("TP3: Swing Target")
    remaining_pct_short := 0.0
var float entry_price_long = na
var float entry_price_short = na
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entry_price_long := strategy.opentrades.entry_price(0)
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    entry_price_short := strategy.opentrades.entry_price(0)
if strategy.position_size == 0
    entry_price_long := na
    entry_price_short := na
float pip_value = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") ? syminfo.mintick : syminfo.mintick * 10
// --- Breakeven System (after TP1) ---
// After TP1: overwrites original SL exit using the SAME "SL " exit ID.
// Moves stop to entry + offset (breakeven). No ratcheting — lets TP2/TP3 runners breathe.
var bool be_active_long = false
var bool be_active_short = false
if strategy.position_size == 0
    be_active_long := false
    be_active_short := false
// Activate BE after TP1 hit
if strategy.position_size > 0 and tp1_hit_long and not be_active_long
    be_active_long := true
if strategy.position_size < 0 and tp1_hit_short and not be_active_short
    be_active_short := true
// Long: move SL to breakeven
if be_active_long and strategy.position_size > 0 and not na(entry_price_long)
    float be_price = entry_price_long + (i_breakevenOffsetPips * pip_value)
    for i = 0 to array.size(LONG_IDS) - 1
        string eid = array.get(LONG_IDS, i)
        strategy.exit("SL " + eid, eid, stop=be_price)
// Short: move SL to breakeven
if be_active_short and strategy.position_size < 0 and not na(entry_price_short)
    float be_price = entry_price_short - (i_breakevenOffsetPips * pip_value)
    for i = 0 to array.size(SHORT_IDS) - 1
        string eid = array.get(SHORT_IDS, i)
        strategy.exit("SL " + eid, eid, stop=be_price)
float entry_level_buy_15m = ltf_15m_c
float entry_level_sell_15m = ltf_15m_c
float entry_level_buy_30m = ltf_30m_c
float entry_level_sell_30m = ltf_30m_c
// --- Dynamic SL: lowest of (baseline touch low, entry bar low, 50 EMA) minus ATR buffer ---
float sl_long_15m = math.min(
     nz(baseline_touch_low_buy_15m, ltf_15m_l),
     ltf_15m_l,
     eff_15m_ema50
     ) - nz(eff_15m_atr14) * 0.5
float sl_short_15m = math.max(
     nz(baseline_touch_high_sell_15m, ltf_15m_h),
     ltf_15m_h,
     eff_15m_ema50
     ) + nz(eff_15m_atr14) * 0.5
float sl_long_30m = math.min(
     nz(baseline_touch_low_buy_30m, ltf_30m_l),
     ltf_30m_l,
     eff_30m_ema50
     ) - nz(eff_30m_atr14) * 0.5
float sl_short_30m = math.max(
     nz(baseline_touch_high_sell_30m, ltf_30m_h),
     ltf_30m_h,
     eff_30m_ema50
     ) + nz(eff_30m_atr14) * 0.5
// --- SL Cap: clamp stops to max distance from entry ---
float max_sl_dist = i_maxSlPips * pip_value
sl_long_15m  := math.max(sl_long_15m,  entry_level_buy_15m  - max_sl_dist)
sl_short_15m := math.min(sl_short_15m, entry_level_sell_15m + max_sl_dist)
sl_long_30m  := math.max(sl_long_30m,  entry_level_buy_30m  - max_sl_dist)
sl_short_30m := math.min(sl_short_30m, entry_level_sell_30m + max_sl_dist)
f_execute_entry(_id, _direction, _stop_loss, _risk_pct, _entry_price, _ltf_close, _comment) =>
    if i_backtestMode
        if i_useDefaultQty
            strategy.entry(_id, _direction, comment=_comment)
        else
            float ps = f_position_size(close, _stop_loss, _risk_pct)
            strategy.entry(_id, _direction, qty=math.max(ps, 0.01), comment=_comment)
        strategy.exit("SL " + _id, _id, stop=_stop_loss)
    else
        float ps = f_position_size(_ltf_close, _stop_loss, _risk_pct)
        strategy.entry(_id, _direction, qty=math.max(ps, 0.01), stop=_entry_price, comment=_comment)
if can_trade
    if i_trade15m and final_day3_buy_15m
        f_execute_entry("D3 Long 15m", strategy.long, sl_long_15m, buy_risk_percent_15m, entry_level_buy_15m, ltf_15m_c, fbr_origin_cycle ? "FBR-D3-15m" : "D3-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_long_15m
        entry_timeframe := "15"
    else if i_trade15m and final_day3_sell_15m
        f_execute_entry("D3 Short 15m", strategy.short, sl_short_15m, sell_risk_percent_15m, entry_level_sell_15m, ltf_15m_c, fbr_origin_cycle ? "FBR-D3-15m" : "D3-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_short_15m
        entry_timeframe := "15"
    else if i_trade15m and final_day2_buy_15m
        f_execute_entry("D2 Long 15m", strategy.long, sl_long_15m, buy_risk_percent_15m, entry_level_buy_15m, ltf_15m_c, fbr_origin_cycle ? "FBR-D2-15m" : "D2-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_long_15m
        entry_timeframe := "15"
    else if i_trade15m and final_day2_sell_15m
        f_execute_entry("D2 Short 15m", strategy.short, sl_short_15m, sell_risk_percent_15m, entry_level_sell_15m, ltf_15m_c, fbr_origin_cycle ? "FBR-D2-15m" : "D2-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_short_15m
        entry_timeframe := "15"
    else if i_trade30m and final_day3_buy_30m
        f_execute_entry("D3 Long 30m", strategy.long, sl_long_30m, buy_risk_percent_30m, entry_level_buy_30m, ltf_30m_c, fbr_origin_cycle ? "FBR-D3-30m" : "D3-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_long_30m
        entry_timeframe := "30"
    else if i_trade30m and final_day3_sell_30m
        f_execute_entry("D3 Short 30m", strategy.short, sl_short_30m, sell_risk_percent_30m, entry_level_sell_30m, ltf_30m_c, fbr_origin_cycle ? "FBR-D3-30m" : "D3-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_short_30m
        entry_timeframe := "30"
    else if i_trade30m and final_day2_buy_30m
        f_execute_entry("D2 Long 30m", strategy.long, sl_long_30m, buy_risk_percent_30m, entry_level_buy_30m, ltf_30m_c, fbr_origin_cycle ? "FBR-D2-30m" : "D2-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_long_30m
        entry_timeframe := "30"
    else if i_trade30m and final_day2_sell_30m
        f_execute_entry("D2 Short 30m", strategy.short, sl_short_30m, sell_risk_percent_30m, entry_level_sell_30m, ltf_30m_c, fbr_origin_cycle ? "FBR-D2-30m" : "D2-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_short_30m
        entry_timeframe := "30"
    else if i_trade15m and final_pure_buy_15m
        f_execute_entry("MAD Long 15m", strategy.long, sl_long_15m, buy_risk_percent_15m, entry_level_buy_15m, ltf_15m_c, "MAD-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_long_15m
        entry_timeframe := "15"
    else if i_trade15m and final_pure_sell_15m
        f_execute_entry("MAD Short 15m", strategy.short, sl_short_15m, sell_risk_percent_15m, entry_level_sell_15m, ltf_15m_c, "MAD-15m")
        entry_candle_low := ltf_15m_l
        entry_candle_high := ltf_15m_h
        active_sl_price := sl_short_15m
        entry_timeframe := "15"
    else if i_trade30m and final_pure_buy_30m
        f_execute_entry("MAD Long 30m", strategy.long, sl_long_30m, buy_risk_percent_30m, entry_level_buy_30m, ltf_30m_c, "MAD-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_long_30m
        entry_timeframe := "30"
    else if i_trade30m and final_pure_sell_30m
        f_execute_entry("MAD Short 30m", strategy.short, sl_short_30m, sell_risk_percent_30m, entry_level_sell_30m, ltf_30m_c, "MAD-30m")
        entry_candle_low := ltf_30m_l
        entry_candle_high := ltf_30m_h
        active_sl_price := sl_short_30m
        entry_timeframe := "30"
