bool sell_5m_confirm = (fiveM_ema9 < fiveM_ema50) and (fiveM_ema18 < fiveM_ema50) and (fiveM_ema9 < fiveM_ema18) and (fiveM_ema50 < nz(fiveM_ema50[3]))
