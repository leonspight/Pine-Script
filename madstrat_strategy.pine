//@version=6
strategy("Madstrat Strategy",
         shorttitle="Madstrat",
         overlay=true,
         calc_on_every_tick=false,
         process_orders_on_close=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=2,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.05,
         slippage=1,
         max_bars_back=5000,
         max_lines_count=500,
         max_labels_count=500,
         max_boxes_count=500)
const int PREFIX_NONE = 0
const int PREFIX_GSD  = 1
const int PREFIX_RSD  = 2
const int PREFIX_GD   = 3
const int PREFIX_RD   = 4
const int DLABEL_NORMAL      = 0
const int DLABEL_INSIDE      = 1
const int DLABEL_CLEAN_BULL  = 2
const int DLABEL_CLEAN_BEAR  = 3
const int DLABEL_FBR_BULL    = 4
const int DLABEL_FBR_BEAR    = 5
const int DLABEL_SETUP_GREEN = 6
const int DLABEL_SETUP_RED   = 7
const int DLABEL_INSIDE_CONT = 8
// SECTION 2: INPUTS
string group_backtest = "Backtest Settings"
bool i_backtestMode = input.bool(true, "Enable Backtest Mode", group=group_backtest)
bool i_useDefaultQty = input.bool(true, "Use Default Position Size", group=group_backtest)
bool i_relaxedConditions = input.bool(false, "Relaxed Entry Conditions", group=group_backtest)
string group_strategy = "Strategy Settings"
string i_accountType = input.string("Live", "Account Type", options=["Live", "Prop Firm"], group=group_strategy)
float i_riskPercent_A_Live = input.float(10.0, "A Setup Risk - Live (%)", minval=0.1, maxval=15.0, step=0.1, group=group_strategy)
float i_riskPercent_B_Live = input.float(5.0, "B Setup Risk - Live (%)", minval=0.1, maxval=15.0, step=0.1, group=group_strategy)
float i_riskPercent_A_Prop = input.float(1.0, "A Setup Risk - Prop (%)", minval=0.1, maxval=5.0, step=0.1, group=group_strategy)
float i_riskPercent_B_Prop = input.float(0.5, "B Setup Risk - Prop (%)", minval=0.1, maxval=5.0, step=0.1, group=group_strategy)
string i_setupType = input.string("Both A and B", "Setup Type to Trade", options=["A Setups Only", "B Setups Only", "Both A and B"], group=group_strategy)
string group_timezone = "▸ Timezone"
string i_masterTimezone = input.string("America/New_York", "Master Timezone", options=["America/New_York", "Europe/London", "Asia/Tokyo", "Asia/Hong_Kong", "Australia/Sydney", "UTC"], group=group_timezone)
bool i_useChartTimezone = input.bool(false, "Use Chart Timezone Instead", group=group_timezone)
string tz_effective = i_useChartTimezone ? syminfo.timezone : i_masterTimezone
float i_riskPercent_A = i_accountType == "Live" ? i_riskPercent_A_Live : i_riskPercent_A_Prop
float i_riskPercent_B = i_accountType == "Live" ? i_riskPercent_B_Live : i_riskPercent_B_Prop
float i_minRR = input.float(2.0, "Minimum RR Required", minval=1.0, maxval=10.0, step=0.5, group=group_strategy)
bool i_trade15m = input.bool(true, "Trade 15m Signals", group=group_strategy, inline="tf_trade")
bool i_trade30m = input.bool(true, "Trade 30m Signals", group=group_strategy, inline="tf_trade")
bool i_enforceFBRDirection = input.bool(true, "Enforce FBR Candle Direction (M-03)", group=group_strategy)
bool i_enforceDailyDirection = input.bool(true, "Enforce Daily Candle Direction (W-13)", group=group_strategy)
string i_directionLock = input.string("Both", "Direction Lock (v10)", options=["Both", "Long Only", "Short Only"], group=group_strategy, tooltip="Manual directional bias per pair. Set based on your HTF analysis. Long Only blocks all short entries. Short Only blocks all long entries.")
string i_htfTrendMode = input.string("Off", "HTF Trend Filter (v10)", options=["Off", "Daily 50 EMA", "Daily EMA Stack", "H4 EMA", "Daily + H4"], group=group_strategy, tooltip="Optional dynamic filter using HTF EMA structure. Off = no HTF gating (recommended). Daily 50 EMA = prev day close vs D1 50 EMA. Daily EMA Stack = D1 9>18>50. H4 EMA = H4 9 vs 50. Daily + H4 = both agree. WARNING: Can block profitable mean-reversion entries.")
bool i_enforceDay4Rule = input.bool(true, "Enable Day 4 Breakout Rule (M-02)", group=group_strategy)
bool i_enableInsideDayCont = input.bool(true, "Inside Day Continuation Mode (S1.2)", group=group_strategy)
string group_risk = "▸ Risk"
float i_spreadPips = input.float(1.5, "Est. Spread (pips)", minval=0.0, maxval=10.0, step=0.5, group=group_risk)
float i_maxSlPips = input.float(30.0, "Max Stop Loss (pips)", minval=10.0, maxval=100.0, step=1.0, group=group_risk, tooltip="Hard cap on stop distance from entry. Stops computed beyond this distance are clamped to this value.")
bool i_enableBreakeven = input.bool(true, "Enable Breakeven Management", group=group_risk)
float i_breakevenTriggerPips = input.float(10.0, "Breakeven Trigger (pips)", minval=1.0, maxval=50.0, step=1.0, group=group_risk)
float i_breakevenOffsetPips = input.float(1.0, "Breakeven Offset (pips)", minval=0.0, maxval=10.0, step=0.5, group=group_risk)
bool i_breakevenOnFirstLevel = input.bool(true, "Move to BE on First Daily Level", group=group_risk)
string i_trailMode = input.string("None", "Trailing Stop After TP1 (S2.3)", options=["None", "EMA 9", "EMA 18", "Fixed Pips", "ATR"], group=group_risk)
float i_tp1ClosePct = input.float(33.0, "TP1 Close %", minval=10.0, maxval=75.0, step=1.0, group=group_risk, tooltip="Percentage of position to close at TP1. Lower values leave more for TP2/TP3 runners.")
float i_trailFixedPips = input.float(15.0, "Trail Fixed Pips", minval=1.0, maxval=100.0, step=1.0, group=group_risk)
float i_trailAtrMult = input.float(1.5, "Trail ATR Multiplier", minval=0.5, maxval=5.0, step=0.25, group=group_risk)
int i_trailAtrPeriod = input.int(14, "Trail ATR Period", minval=5, maxval=50, group=group_risk)
bool i_enableM1R3Exit = input.bool(false, "Enable M1-R3 EMA Reversal Exit", group=group_risk, tooltip="Full position exit when signal-TF EMAs reverse and entry candle broken. Disable to let TP/SL handle remaining position.")
bool i_enableM1R1Exit = input.bool(false, "Enable M1-R1 Exhaustion Reject Exit", group=group_risk, tooltip="50% close on exhaustion zone rejection before TP1. Disable to let TP1 handle the first partial.")
bool i_enableDDBreaker = input.bool(false, "Enable Daily Drawdown Limit", group=group_risk)
float i_maxDailyDD = input.float(5.0, "Max Daily Drawdown (%)", minval=1.0, maxval=25.0, step=0.5, group=group_risk)
bool i_enableThreeStrike = input.bool(false, "Enable Three-Strike Rule", group=group_risk)
int i_maxDailyLosses = input.int(3, "Max Daily Losses (Strikes)", minval=1, maxval=10, group=group_risk)
bool i_enableTradeFreqLimit = input.bool(false, "Enable Trade Frequency Limits", group=group_risk)
int i_maxDailyTrades = input.int(2, "Max Trades Per Day", minval=1, maxval=10, group=group_risk)
int i_maxWeeklyTrades = input.int(4, "Max Trades Per Week", minval=1, maxval=20, group=group_risk)
bool i_enableWeeklyDD = input.bool(false, "Enable Weekly Drawdown Limit (S3.3)", group=group_risk)
float i_maxWeeklyDD = input.float(8.0, "Max Weekly Drawdown (%)", minval=2.0, maxval=30.0, step=1.0, group=group_risk)
bool i_enableConsecLossLimit = input.bool(false, "Enable Consecutive Loss Limit (S3.3)", group=group_risk)
int i_maxConsecLosses = input.int(2, "Max Consecutive Losses", minval=1, maxval=5, group=group_risk)
string group_instrument = "Instrument Settings"
string i_instrumentType = input.string("Auto-Detect", "Instrument Type", options=["Auto-Detect", "Gold/Metals", "Forex"], group=group_instrument)
string group_confluence = "Confluence Settings"
string i_confluenceTableSystem = input.string("Auto (Match Chart TF)", "Confluence Table Shows", options=["15m System", "30m System", "Auto (Match Chart TF)"], group=group_confluence)
int i_pureMinConfluence = input.int(7, "Pure Madstrat Min Confluence", minval=1, maxval=11, group=group_confluence)
bool i_useDynamicConfluence = input.bool(true, "Use Dynamic Confluence for Day 3", group=group_confluence)
int i_day3MinConfluence = input.int(3, "Day 3 Min Confluence (if not dynamic)", minval=1, maxval=12, group=group_confluence)
int i_confluenceBoost = input.int(0, "Confluence Boost (v10)", minval=0, maxval=5, step=1, group=group_confluence, tooltip="Extra confluence points added to ALL thresholds. Use +2 or +3 on pairs with marginal edge (e.g. GBPUSD) to filter out low-quality setups. 0 = no change from baseline.")
bool i_requireEQRejection = input.bool(true, "Require EQ Rejection", group=group_confluence)
int i_maxEQSignals = input.int(3, "Max Signals Per EQ Cycle", minval=1, maxval=10, group=group_confluence)
int i_eqLookback15m = input.int(12, "EQ Rejection Lookback (15m bars)", minval=1, maxval=30, group=group_confluence)
int i_eqLookback30m = input.int(6, "EQ Rejection Lookback (30m bars)", minval=1, maxval=20, group=group_confluence)
string group_htf = "▸ HTF"
int i_htfBaselineLookback1hr = input.int(4, "1hr Baseline Lookback (bars)", minval=1, maxval=20, group=group_htf)
int i_htfEQLookback1hr = input.int(4, "1hr EQ Lookback (bars)", minval=1, maxval=20, group=group_htf)
int i_htfBaselineLookback2hr = input.int(2, "2hr Baseline Lookback (bars)", minval=1, maxval=20, group=group_htf)
int i_htfEQLookback2hr = input.int(2, "2hr EQ Lookback (bars)", minval=1, maxval=20, group=group_htf)
bool i_requireHTFConfirmation = input.bool(true, "Require HTF Confirmation", group=group_htf)
bool i_blockOnHTFRejection = input.bool(true, "Block on HTF EMA Rejection", group=group_htf)
int i_htfRejectionLookback1hr = input.int(2, "1hr Rejection Lookback (bars)", minval=1, maxval=10, group=group_htf)
int i_htfRejectionLookback2hr = input.int(1, "2hr Rejection Lookback (bars)", minval=1, maxval=10, group=group_htf)
bool i_requireAllLevelsTouched = input.bool(false, "Require All Levels Touched", group=group_htf)
string group_ltf = "▸ LTF"
int i_ltf50EMALookback15m = input.int(5, "50 EMA Touch Lookback (15m)", minval=1, maxval=20, group=group_ltf)
int i_ltf50EMALookback30m = input.int(3, "50 EMA Touch Lookback (30m)", minval=1, maxval=20, group=group_ltf)
int i_ltf50SMALookback15m = input.int(5, "50 SMA Touch Lookback (15m)", minval=1, maxval=20, group=group_ltf)
int i_ltf50SMALookback30m = input.int(3, "50 SMA Touch Lookback (30m)", minval=1, maxval=20, group=group_ltf)
int i_ltf18EMALookback15m = input.int(3, "18 EMA Touch Lookback (15m)", minval=1, maxval=20, group=group_ltf)
int i_ltf18EMALookback30m = input.int(2, "18 EMA Touch Lookback (30m)", minval=1, maxval=20, group=group_ltf)
int i_ltf9EMALookback15m = input.int(2, "9 EMA Touch Lookback (15m)", minval=1, maxval=20, group=group_ltf)
int i_ltf9EMALookback30m = input.int(1, "9 EMA Touch Lookback (30m)", minval=1, maxval=20, group=group_ltf)
string group_signals = "Signal Types"
bool i_showDay3 = input.bool(true, "Show Day 2/3 Madstrat Signals", group=group_signals)
bool i_showPureMad = input.bool(true, "Show Pure Madstrat Signals", group=group_signals)
int i_maxSignalsPerSession = input.int(5, "Max Signals Per Session", minval=1, maxval=20, group=group_signals)
string group_session_filter = "Session Filter"
bool i_enableSessionFilter = input.bool(false, "Enable Session Filter", group=group_session_filter)
bool i_allowSydney = input.bool(true, "Allow Sydney Signals", group=group_session_filter, inline="sess1")
bool i_allowAsian = input.bool(true, "Allow Asian Signals", group=group_session_filter, inline="sess1")
bool i_allowLondon = input.bool(true, "Allow London Signals", group=group_session_filter, inline="sess2")
bool i_allowNY = input.bool(true, "Allow NY Signals", group=group_session_filter, inline="sess2")
bool i_enableOverlapConfluence = input.bool(true, "Enable Session Overlap Confluence (S2.1)", group=group_session_filter)
bool i_enableKillzoneEntry = input.bool(true, "Killzone Entry Only", group=group_session_filter, tooltip="Only allow entries during the London/NY overlap killzone window")
int i_killzoneStartHour = input.int(8, "Killzone Start (ET)", minval=0, maxval=23, group=group_session_filter, inline="kz")
int i_killzoneEndHour = input.int(12, "End", minval=0, maxval=23, group=group_session_filter, inline="kz")
string group_session_boxes = "▸ Sessions"
bool i_showSessionBoxes = input.bool(true, "Show Session Boxes", group=group_session_boxes)
int i_sessionBoxCount = input.int(10, "Historical Sessions to Show", minval=5, maxval=50, group=group_session_boxes)
bool i_sessionBoxLabels = input.bool(true, "Show Session Labels", group=group_session_boxes)
string i_sessionLabelSize = input.string("tiny", "Label Size", options=["tiny", "small", "normal"], group=group_session_boxes)
bool i_showSessionMidlines = input.bool(false, "Show Session Midlines", group=group_session_boxes)
bool i_showSessionHL = input.bool(true, "Show Session H/L Lines", group=group_session_boxes)
