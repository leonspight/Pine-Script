f_stack_buy_relaxed(_close, _ema9, _ema18, _ema50) =>
    (_close > _ema9) and (_close > _ema18) and (_ema9 > _ema18) and (_ema9 > _ema50) and (_ema18 > _ema50)
f_stack_sell_relaxed(_close, _ema9, _ema18, _ema50) =>
