if not na(_pivot_low)
    next_swing_low := na(next_swing_low) ? _pivot_low : math.min(next_swing_low, _pivot_low)
if rollover5
    next_swing_high := na
    next_swing_low := na
f_second_exhaustion_long(_entry, _first_tp) =>
    float secondZone = na
    float min_dist = 999999.0
    float first_level = nz(_first_tp, _entry)
    if not na(active_15m_top) and active_15m_top > first_level + tolerance_points
        float dist = active_15m_top - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := active_15m_top
    if not na(active_30m_top) and active_30m_top > first_level + tolerance_points
        float dist = active_30m_top - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := active_30m_top
    if not na(active_h1_top) and active_h1_top > first_level + tolerance_points
        float dist = active_h1_top - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := active_h1_top
    if not na(active_h4_top) and active_h4_top > first_level + tolerance_points
        float dist = active_h4_top - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := active_h4_top
    if not na(asia_session_high) and asia_session_high > first_level + tolerance_points
        float dist = asia_session_high - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := asia_session_high
    if not na(london_session_high) and london_session_high > first_level + tolerance_points
        float dist = london_session_high - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := london_session_high
    if not na(ny_session_high) and ny_session_high > first_level + tolerance_points
        float dist = ny_session_high - first_level
        if dist < min_dist
            min_dist := dist
            secondZone := ny_session_high
    if na(secondZone)
        if not na(pdh) and pdh > first_level + tolerance_points
            secondZone := pdh
        else if not na(prev_week_high) and prev_week_high > first_level + tolerance_points
            secondZone := prev_week_high
    secondZone
f_second_exhaustion_short(_entry, _first_tp) =>
    float secondZone = na
    float min_dist = 999999.0
    float first_level = nz(_first_tp, _entry)
    if not na(active_15m_bot) and active_15m_bot < first_level - tolerance_points
        float dist = first_level - active_15m_bot
        if dist < min_dist
            min_dist := dist
            secondZone := active_15m_bot
    if not na(active_30m_bot) and active_30m_bot < first_level - tolerance_points
        float dist = first_level - active_30m_bot
        if dist < min_dist
            min_dist := dist
            secondZone := active_30m_bot
    if not na(active_h1_bot) and active_h1_bot < first_level - tolerance_points
        float dist = first_level - active_h1_bot
        if dist < min_dist
            min_dist := dist
            secondZone := active_h1_bot
    if not na(active_h4_bot) and active_h4_bot < first_level - tolerance_points
        float dist = first_level - active_h4_bot
        if dist < min_dist
            min_dist := dist
            secondZone := active_h4_bot
    if not na(asia_session_low) and asia_session_low < first_level - tolerance_points
        float dist = first_level - asia_session_low
        if dist < min_dist
            min_dist := dist
            secondZone := asia_session_low
    if not na(london_session_low) and london_session_low < first_level - tolerance_points
        float dist = first_level - london_session_low
        if dist < min_dist
            min_dist := dist
            secondZone := london_session_low
    if not na(ny_session_low) and ny_session_low < first_level - tolerance_points
        float dist = first_level - ny_session_low
        if dist < min_dist
            min_dist := dist
            secondZone := ny_session_low
    if na(secondZone)
        if not na(pdl) and pdl < first_level - tolerance_points
            secondZone := pdl
        else if not na(prev_week_low) and prev_week_low < first_level - tolerance_points
            secondZone := prev_week_low
    secondZone
var float active_sl_price = na
float tp_anchor_long  = strategy.position_size > 0 ? strategy.position_avg_price : close
float tp_anchor_short = strategy.position_size < 0 ? strategy.position_avg_price : close
// --- TP1 minimum distance filter: hard pip floor + SL-based 1.5× check ---
float sl_dist_long  = not na(active_sl_price) and strategy.position_size > 0 ? math.abs(tp_anchor_long - active_sl_price) : na
float sl_dist_short = not na(active_sl_price) and strategy.position_size < 0 ? math.abs(active_sl_price - tp_anchor_short) : na
float pip_unit      = syminfo.mintick * 10
float hard_tp1_floor = 20.0 * pip_unit  // Absolute minimum 20 pips to TP1
float min_tp1_dist_long  = math.max(not na(sl_dist_long)  ? sl_dist_long  * 1.5 : 0.0, hard_tp1_floor)
float min_tp1_dist_short = math.max(not na(sl_dist_short) ? sl_dist_short * 1.5 : 0.0, hard_tp1_floor)
float raw_tp1_long  = f_nearest_exhaustion_long(tp_anchor_long)
float raw_tp1_short = f_nearest_exhaustion_short(tp_anchor_short)
// If nearest exhaustion zone is too close, promote TP1 to second zone
bool tp1_long_too_close  = not na(raw_tp1_long)  and (raw_tp1_long - tp_anchor_long) < min_tp1_dist_long
bool tp1_short_too_close = not na(raw_tp1_short) and (tp_anchor_short - raw_tp1_short) < min_tp1_dist_short
float tp1_long  = tp1_long_too_close  ? f_second_exhaustion_long(tp_anchor_long, raw_tp1_long)   : raw_tp1_long
// Final guard: if promoted zone is STILL below 20-pip floor, disable TP1 entirely — let TP2/SL manage
float tp1_long_final_dist = not na(tp1_long) ? (tp1_long - tp_anchor_long) : 0.0
tp1_long := tp1_long_final_dist < hard_tp1_floor ? na : tp1_long
float tp2_long  = tp1_long_too_close  ? na : f_second_exhaustion_long(tp_anchor_long, nz(tp1_long))
float tp3_long  = not na(next_swing_high) and next_swing_high > nz(tp2_long, nz(tp1_long)) ? next_swing_high : nz(prev_week_high) * 1.005
float tp1_short = tp1_short_too_close ? f_second_exhaustion_short(tp_anchor_short, raw_tp1_short) : raw_tp1_short
float tp1_short_final_dist = not na(tp1_short) ? (tp_anchor_short - tp1_short) : 0.0
tp1_short := tp1_short_final_dist < hard_tp1_floor ? na : tp1_short
float tp2_short = tp1_short_too_close ? na : f_second_exhaustion_short(tp_anchor_short, nz(tp1_short))
float tp3_short = not na(next_swing_low) and next_swing_low < nz(tp2_short, nz(tp1_short)) ? next_swing_low : nz(prev_week_low) * 0.995
var float entry_candle_low = na
var float entry_candle_high = na
var string entry_timeframe = na
var bool   tp1_hit_long   = false
var bool   tp2_hit_long   = false
var bool   tp1_hit_short  = false
var bool   tp2_hit_short  = false
var bool   m1r2_hit_long  = false
var bool   m1r2_hit_short = false
var float  remaining_pct_long  = 100.0
var float  remaining_pct_short = 100.0
if strategy.position_size == 0
    tp1_hit_long       := false
    tp2_hit_long       := false
    tp1_hit_short      := false
    tp2_hit_short      := false
    m1r2_hit_long      := false
    m1r2_hit_short     := false
    remaining_pct_long := 100.0
    remaining_pct_short := 100.0
    active_sl_price    := na
    entry_timeframe    := na
var array<string> LONG_IDS = array.from(
     "D2 Long 15m", "D3 Long 15m", "D2 Long 30m", "D3 Long 30m",
     "MAD Long 15m", "MAD Long 30m", "EQ Long 15m", "EQ Long 30m")
var array<string> SHORT_IDS = array.from(
     "D2 Short 15m", "D3 Short 15m", "D2 Short 30m", "D3 Short 30m",
     "MAD Short 15m", "MAD Short 30m", "EQ Short 15m", "EQ Short 30m")
f_partial_close_longs(_pct, _comment) =>
    for i = 0 to array.size(LONG_IDS) - 1
        strategy.close(array.get(LONG_IDS, i), qty_percent=_pct, comment=_comment)
f_partial_close_shorts(_pct, _comment) =>
    for i = 0 to array.size(SHORT_IDS) - 1
        strategy.close(array.get(SHORT_IDS, i), qty_percent=_pct, comment=_comment)
bool exit_stop_long = false
bool exit_stop_short = false
if i_enableM1R3Exit and strategy.position_size > 0
    // M1-R3: Use signal timeframe EMAs (not chart-level) to avoid premature exits from 5m noise
    float r3_ema9  = entry_timeframe == "30" ? eff_30m_ema9  : eff_15m_ema9
    float r3_ema18 = entry_timeframe == "30" ? eff_30m_ema18 : eff_15m_ema18
    float r3_ema50 = entry_timeframe == "30" ? eff_30m_ema50 : eff_15m_ema50
    bool emas_back_below = (r3_ema9 < r3_ema50) and (r3_ema18 < r3_ema50)
    bool break_entry_low = not na(entry_candle_low) and low < entry_candle_low
    if emas_back_below and break_entry_low
        exit_stop_long := true
if i_enableM1R3Exit and strategy.position_size < 0
    float r3_ema9  = entry_timeframe == "30" ? eff_30m_ema9  : eff_15m_ema9
    float r3_ema18 = entry_timeframe == "30" ? eff_30m_ema18 : eff_15m_ema18
    float r3_ema50 = entry_timeframe == "30" ? eff_30m_ema50 : eff_15m_ema50
    bool emas_back_above = (r3_ema9 > r3_ema50) and (r3_ema18 > r3_ema50)
    bool break_entry_high = not na(entry_candle_high) and high > entry_candle_high
    if emas_back_above and break_entry_high
        exit_stop_short := true
bool exit_tp1_long = false
bool exit_tp1_short = false
if strategy.position_size > 0 and not tp1_hit_long
    // Runtime guard: even if tp1_long is not na, reject if distance from avg entry is below hard floor
    float tp1_dist_from_entry_l = not na(tp1_long) ? (tp1_long - strategy.position_avg_price) : 0.0
    if not na(tp1_long) and high >= tp1_long and tp1_dist_from_entry_l >= hard_tp1_floor
        exit_tp1_long := true
if strategy.position_size < 0 and not tp1_hit_short
    float tp1_dist_from_entry_s = not na(tp1_short) ? (strategy.position_avg_price - tp1_short) : 0.0
    if not na(tp1_short) and low <= tp1_short and tp1_dist_from_entry_s >= hard_tp1_floor
        exit_tp1_short := true
bool exit_tp2_long = false
bool exit_tp2_short = false
if strategy.position_size > 0 and tp1_hit_long and not tp2_hit_long
    if not na(tp2_long) and high >= tp2_long
        exit_tp2_long := true
if strategy.position_size < 0 and tp1_hit_short and not tp2_hit_short
    if not na(tp2_short) and low <= tp2_short
        exit_tp2_short := true
bool exit_tp3_long = false
bool exit_tp3_short = false
if strategy.position_size > 0 and tp2_hit_long
    if not na(tp3_long) and high >= tp3_long
        exit_tp3_long := true
if strategy.position_size < 0 and tp2_hit_short
    if not na(tp3_short) and low <= tp3_short
        exit_tp3_short := true
// SECTION 9A: EXHAUSTION AREA DETECTION (M2) - OPTION D HYBRID CASCADE
int TF_H4  = 4
int TF_H1  = 3
int TF_30M = 2
int TF_15M = 1
bool asia_start = hour(time, i_rolloverTimezone) == i_asianStartHour and minute == i_asianStartMin
bool london_start = hour(time, i_rolloverTimezone) == i_londonStartHour and minute == i_londonStartMin
bool ny_start = hour(time, i_rolloverTimezone) == i_nyStartHour and minute == i_nyStartMin
var int asia_high_time = na
var int asia_low_time = na
var int london_high_time = na
var int london_low_time = na
var int ny_high_time = na
var int ny_low_time = na
if asia_start
    asia_session_high := high
    asia_session_low := low
